<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_session_dashboard_form" model="ir.ui.view">
        <field name="name">avea.till.session.dashboard.form</field>
        <field name="model">avea.till.session.dashboard</field>
        <field name="arch" type="xml">
            <form string="Session Dashboard" create="false" duplicate="false" delete="false" class="o_avea_workspace o_avea_workspace--session">
                <header class="o_avea_workspace_header">
                    <button
                        name="action_refresh"
                        type="object"
                        string="Session Dashboard"
                        class="btn-primary o_avea_workspace_nav o_avea_workspace_nav--active"
                    />
                    <button
                        name="action_open_cash_ledger"
                        type="object"
                        string="Cash Ledger"
                        class="btn-secondary o_avea_workspace_nav"
                    />
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh"
                        class="btn-secondary o_avea_workspace_refresh"
                        icon="fa-refresh"
                    />
                </header>
                <sheet class="o_avea_workspace_sheet">
                    <field name="currency_id" invisible="1"/>

                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">Live Session Overview</span>
                            <h1 class="o_avea_workspace_title">Session Dashboard</h1>
                        </div>
                        <div class="o_avea_workspace_hero_stats">
                            <div class="o_avea_workspace_hero_stat o_avea_workspace_hero_stat--primary">
                                <span class="o_avea_workspace_hero_stat_label">Active POS Session</span>
                                <field name="session_id" nolabel="1" readonly="0" options="{'no_create': True}" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                            <div class="o_avea_workspace_hero_stat">
                                <span class="o_avea_workspace_hero_stat_label">Till</span>
                                <field name="config_id" nolabel="1" readonly="1" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                            <div class="o_avea_workspace_hero_stat">
                                <span class="o_avea_workspace_hero_stat_label">Cashier</span>
                                <field name="cashier_id" nolabel="1" readonly="1" widget="many2one_avatar_user" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                            <div class="o_avea_workspace_hero_stat">
                                <span class="o_avea_workspace_hero_stat_label">Session Status</span>
                                <field name="session_state" nolabel="1" readonly="1" widget="badge" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Session Information</h2>
                        </div>
                        <div class="o_avea_workspace_info_card">
                            <div class="o_avea_workspace_info_grid">
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">POS / Till</span>
                                    <field name="config_id" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Session Number</span>
                                    <field name="session_id" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Cashier</span>
                                    <field name="cashier_id" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Opening Time</span>
                                    <field name="session_opening_time" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Duration</span>
                                    <field name="session_duration" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Status</span>
                                    <field name="session_state" nolabel="1" readonly="1" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Sales Summary</h2>
                        </div>
                        <div class="o_avea_workspace_kpi_grid">
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Total Sales</span>
                                <field name="total_sales" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--positive">
                                <span class="o_avea_workspace_kpi_label">Cash Sales</span>
                                <field name="cash_sales" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Card Sales</span>
                                <field name="card_sales" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Other Payments</span>
                                <field name="other_payments" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Orders</span>
                                <field name="order_count" nolabel="1" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Average Order Value</span>
                                <field name="average_order_value" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block o_avea_workspace_block--last">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Session Activity</h2>
                        </div>
                        <div class="o_avea_workspace_activity_grid">
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--info">
                                <span class="o_avea_workspace_activity_label">Items Sold</span>
                                <field name="activity_items_sold" nolabel="1" readonly="1" class="o_avea_workspace_activity_value"/>
                            </div>
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--info">
                                <span class="o_avea_workspace_activity_label">Discounts</span>
                                <field name="activity_discount_total" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_activity_value"/>
                            </div>
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--negative">
                                <span class="o_avea_workspace_activity_label">Refunds</span>
                                <field name="activity_refund_count" nolabel="1" readonly="1" class="o_avea_workspace_activity_value"/>
                            </div>
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--neutral">
                                <span class="o_avea_workspace_activity_label">Cash Movements</span>
                                <field name="activity_cash_movement_count" nolabel="1" readonly="1" class="o_avea_workspace_activity_value"/>
                            </div>
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--positive">
                                <span class="o_avea_workspace_activity_label">Cash In</span>
                                <div class="o_avea_workspace_activity_detail">
                                    <field name="activity_cash_in_count" nolabel="1" readonly="1" class="o_avea_workspace_activity_value"/>
                                    <field name="activity_cash_in_total" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_activity_subvalue"/>
                                </div>
                            </div>
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--negative">
                                <span class="o_avea_workspace_activity_label">Cash Out</span>
                                <div class="o_avea_workspace_activity_detail">
                                    <field name="activity_cash_out_count" nolabel="1" readonly="1" class="o_avea_workspace_activity_value"/>
                                    <field name="activity_cash_out_total" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_activity_subvalue"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_session_dashboard" model="ir.actions.act_window">
        <field name="name">Session Dashboard</field>
        <field name="res_model">avea.till.session.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_avea_session_dashboard_form"/>
        <field name="target">current</field>
    </record>

</odoo>
