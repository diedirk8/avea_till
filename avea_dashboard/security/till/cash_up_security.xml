<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_groups_privilege_avea_cash_up" model="res.groups.privilege">
        <field name="name">Till Cash Up</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_avea_dashboard"/>
    </record>

    <record id="group_avea_cash_up_user" model="res.groups">
        <field name="name">Can Cash Up Own Till</field>
        <field name="comment">May cash up an open POS session on a till they are allowed to operate. Does not grant Cash In/Out, other tills, or accounting access.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_avea_cash_up"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_avea_cash_up_manager" model="res.groups">
        <field name="name">Cash Up Manager</field>
        <field name="comment">May cash up any open till the user can access and review cash-up records.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_avea_cash_up"/>
        <field name="implied_ids" eval="[(4, ref('group_avea_cash_up_user'))]"/>
    </record>

    <record id="rule_avea_cash_up_user" model="ir.rule">
        <field name="name">Avea Cash Up: own till</field>
        <field name="model_id" ref="model_avea_cash_up"/>
        <field name="groups" eval="[(4, ref('group_avea_cash_up_user'))]"/>
        <field name="domain_force">
            ['|',
             ('session_id.user_id', '=', user.id),
             ('session_id.config_id.current_user_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_avea_cash_up_manager" model="ir.rule">
        <field name="name">Avea Cash Up: manager</field>
        <field name="model_id" ref="model_avea_cash_up"/>
        <field name="groups" eval="[(4, ref('group_avea_cash_up_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
