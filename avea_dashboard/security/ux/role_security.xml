<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_groups_privilege_avea_role" model="res.groups.privilege">
        <field name="name">Avea Role</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="module_category_avea_dashboard"/>
    </record>

    <record id="group_avea_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="comment">Sell at the till, cash up own till, and open Session Dashboard. Implies POS user and stock user so the existing POS catalogue loads. Does not grant Odoo apps, Avea stock workspace, operations, or settings.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_avea_role"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_user')), (4, ref('stock.group_stock_user')), (4, ref('group_avea_cash_up_user'))]"/>
    </record>

    <record id="group_avea_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Full Avea navigation and operational capabilities. Does not grant Odoo Settings/Apps (base.group_system).</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_avea_role"/>
        <field name="implied_ids" eval="[(4, ref('group_avea_cashier')), (4, ref('point_of_sale.group_pos_manager')), (4, ref('group_avea_cash_up_manager')), (4, ref('group_avea_credit_manager')), (4, ref('group_avea_correct_payment'))]"/>
    </record>

    <record id="group_avea_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="comment">Business-owner profile. Implies Manager and all Avea capabilities. Does not grant Odoo Settings administrator.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_avea_role"/>
        <field name="implied_ids" eval="[(4, ref('group_avea_manager'))]"/>
    </record>

</odoo>
