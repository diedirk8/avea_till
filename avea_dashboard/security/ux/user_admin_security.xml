<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="group_avea_user_admin" model="res.groups">
        <field name="name">Avea user administration</field>
        <field name="comment">Create and edit Avea staff users, roles, and capabilities. Granted to managers; Odoo Settings administrators always have full access.</field>
        <field name="sequence">25</field>
        <field name="privilege_id" ref="res_groups_privilege_avea_role"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="access_res_users_avea_admin" model="ir.model.access">
        <field name="name">res.users.avea.user.admin</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="group_id" ref="group_avea_user_admin"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_res_users_avea_admin_company" model="ir.rule">
        <field name="name">Avea user admin: company users</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[
            ('share', '=', False),
            '|',
            ('company_id', 'in', company_ids),
            ('company_ids', 'in', company_ids),
        ]</field>
        <field name="groups" eval="[(4, ref('group_avea_user_admin'))]"/>
    </record>

</odoo>
