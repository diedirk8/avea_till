<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_employee_pay_search" model="ir.ui.view">
        <field name="name">avea.employee.pay.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <search string="Pay history">
                <field name="avea_employee_id" string="Employee"/>
                <field name="payment_ref" string="Reference"/>
                <field name="journal_id" string="From"/>
                <separator/>
                <filter string="Salary" name="avea_staff_salary" domain="[('avea_staff_pay_kind', '=', 'salary')]"/>
                <filter string="Advance" name="avea_staff_advance" domain="[('avea_staff_pay_kind', '=', 'advance')]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'avea_employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_avea_employee_pay_list" model="ir.ui.view">
        <field name="name">avea.employee.pay.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list
                string="Pay history"
                create="false"
                delete="false"
                edit="false"
                default_order="date desc, id desc"
                js_class="avea_employee_pay_list"
                class="o_avea_catalogue_flush o_avea_customer_list o_avea_workspace o_avea_workspace--customer o_avea_workspace--customer-list o_avea_workspace--employee"
            >
                <button
                    name="action_avea_open_pay_employee"
                    type="object"
                    string="Open"
                    icon="fa-external-link"
                    title="Open employee"
                    class="btn-link"
                />
                <field name="currency_id" column_invisible="True"/>
                <field name="date" string="Date"/>
                <field name="avea_employee_id" string="Employee"/>
                <field name="avea_staff_pay_kind" string="What"/>
                <field
                    name="avea_staff_salary_total"
                    string="This salary"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                />
                <field
                    name="avea_staff_advance_deducted"
                    string="Already paid"
                    widget="monetary"
                    optional="show"
                    options="{'currency_field': 'currency_id'}"
                />
                <field
                    name="avea_paid_amount"
                    string="Cash paid"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                />
                <field name="journal_id" string="From"/>
                <field name="payment_ref" string="Reference" optional="show"/>
                <field name="avea_staff_pay_note" string="What happened" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_avea_employee_pay_form" model="ir.ui.view">
        <field name="name">avea.employee.pay.form</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <form string="Pay" create="false" delete="false" edit="false" class="o_avea_workspace o_avea_workspace--customer o_avea_workspace--employee">
                <sheet class="o_avea_workspace_sheet">
                    <field name="currency_id" invisible="1"/>
                    <field name="avea_employee_id" invisible="1"/>

                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">Employees</span>
                            <h1 class="o_avea_workspace_title">
                                <field name="avea_staff_pay_kind" nolabel="1" readonly="1"/>
                            </h1>
                            <p class="o_avea_workspace_section_subtitle">
                                <field name="avea_staff_pay_note" nolabel="1" readonly="1"/>
                            </p>
                        </div>
                        <div class="o_avea_customer_hero_actions">
                            <button
                                string="Open employee"
                                name="action_avea_open_pay_employee"
                                type="object"
                                class="btn btn-primary"
                                invisible="not avea_employee_id"
                            />
                            <button
                                string="Pay history"
                                name="action_avea_employee_pay_history"
                                type="object"
                                class="btn btn-secondary"
                            />
                        </div>
                    </div>

                    <div class="o_avea_stock_product_panel">
                        <h2 class="o_avea_workspace_section_title">This payment</h2>
                        <div class="o_avea_stock_product_fields">
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Employee</span>
                                <field name="avea_employee_id" nolabel="1" readonly="1" options="{'no_open': True}"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Date</span>
                                <field name="date" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">What</span>
                                <field name="avea_staff_pay_kind" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">This salary</span>
                                <field name="avea_staff_salary_total" nolabel="1" widget="monetary" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Already paid</span>
                                <field name="avea_staff_advance_deducted" nolabel="1" widget="monetary" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Cash paid</span>
                                <field name="avea_paid_amount" nolabel="1" widget="monetary" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">From</span>
                                <field name="journal_id" nolabel="1" readonly="1" options="{'no_open': True}"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Reference</span>
                                <field name="payment_ref" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_employee_pay_history" model="ir.actions.act_window">
        <field name="name">Pay history</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="groups_id" eval="[(4, ref('group_avea_employee_access'))]"/>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_avea_employee_pay_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_avea_employee_pay_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_avea_employee_pay_form')}),
        ]"/>
        <field name="target">main</field>
        <field name="domain">[('avea_staff_pay_kind', '!=', False)]</field>
        <field name="context">{
            'avea_employee_workspace': True,
            'clear_breadcrumbs': True,
            'no_breadcrumbs': True,
            'create': False,
            'delete': False,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No salary or advance yet
            </p>
            <p>
                Record a salary or advance from an employee, Withdraw, or bank rec.
                An advance is salary paid early and comes off the next salary.
            </p>
        </field>
    </record>

</odoo>
