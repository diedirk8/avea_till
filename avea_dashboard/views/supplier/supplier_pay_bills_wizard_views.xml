<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_supplier_pay_bills_wizard_form" model="ir.ui.view">
        <field name="name">avea.supplier.pay.bills.wizard.form</field>
        <field name="model">avea.supplier.pay.bills.wizard</field>
        <field name="arch" type="xml">
            <form string="New payment" class="o_avea_workspace o_avea_workspace--supplier o_avea_pay_bills_wizard">
                <sheet class="o_avea_pay_bills_sheet">
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="available_journal_ids" invisible="1"/>
                    <field name="payment_warning" invisible="1"/>
                    <field name="amount_over_payment" invisible="1"/>
                    <field name="has_leftover" invisible="1"/>
                    <div class="o_avea_pay_bills_card">
                        <div class="o_avea_pay_bills_card_head">Payment</div>
                        <div class="o_avea_pay_bills_fields">
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Supplier</span>
                                <field
                                    name="partner_id"
                                    nolabel="1"
                                    options="{'no_create': True, 'no_open': True}"
                                    placeholder="Choose supplier"
                                    context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">This payment</span>
                                <field name="payment_amount" nolabel="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Pay from</span>
                                <field
                                    name="journal_id"
                                    nolabel="1"
                                    options="{'no_create': True, 'no_open': True}"
                                    required="1"
                                    placeholder="Bank or cash"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Paid on</span>
                                <field name="pay_date" nolabel="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item o_avea_pay_bills_fields_span">
                                <span class="o_avea_workspace_info_label">Reference</span>
                                <field name="payment_ref" nolabel="1" placeholder="Optional — their EFT reference"/>
                            </div>
                        </div>
                        <div class="o_avea_pay_bills_stats" invisible="not payment_amount">
                            <div class="o_avea_pay_bills_stat">
                                <span class="o_avea_pay_bills_stat_label">This payment</span>
                                <field name="payment_amount" nolabel="1" widget="monetary" readonly="1"/>
                            </div>
                            <div class="o_avea_pay_bills_stat">
                                <span class="o_avea_pay_bills_stat_label">Applied to bills</span>
                                <field name="amount_total" nolabel="1" widget="monetary" readonly="1"/>
                            </div>
                            <div class="o_avea_pay_bills_stat o_avea_pay_bills_stat--left">
                                <span class="o_avea_pay_bills_stat_label">Still unassigned</span>
                                <field name="amount_on_account" nolabel="1" widget="monetary" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    <div
                        class="alert alert-warning o_avea_pay_bills_alert"
                        role="alert"
                        invisible="not payment_warning"
                    >
                        <field name="payment_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="o_avea_pay_bills_card o_avea_pay_bills_card--bills">
                        <div class="o_avea_pay_bills_card_head">
                            <span>Bills to pay</span>
                            <button
                                name="action_allocate_oldest_first"
                                type="object"
                                string="Fill oldest first"
                                class="btn btn-secondary btn-sm"
                                invisible="not payment_amount"
                            />
                        </div>
                        <p class="text-muted o_avea_supplier_open_hint" invisible="line_ids">
                            Choose a supplier to see open bills.
                        </p>
                        <field name="line_ids" nolabel="1" invisible="not line_ids">
                            <list
                                create="false"
                                delete="false"
                                editable="bottom"
                                class="o_avea_pay_bills_lines o_avea_bills_list"
                            >
                                <field name="currency_id" column_invisible="True"/>
                                <field name="bill_id" column_invisible="True"/>
                                <field name="pay" string="Pay"/>
                                <field name="bill_due" string="Due" readonly="1"/>
                                <field name="bill_label" string="What this is" readonly="1"/>
                                <field name="bill_ref" string="Their invoice" optional="hide" readonly="1"/>
                                <field name="amount_due" string="Still open" widget="monetary" readonly="1"/>
                                <field name="amount" string="Pay now" widget="monetary"/>
                            </list>
                        </field>
                    </div>
                    <div class="o_avea_pay_bills_card o_avea_pay_bills_card--leftover" invisible="not has_leftover">
                        <div class="o_avea_pay_bills_card_head">Left of this payment</div>
                        <p class="o_avea_pay_bills_leftover_amount">
                            <field name="amount_on_account" nolabel="1" widget="monetary" readonly="1"/>
                            is not on a bill yet.
                        </p>
                        <field
                            name="leftover_action"
                            widget="radio"
                            nolabel="1"
                            options="{'horizontal': false}"
                        />
                    </div>
                </sheet>
                <footer>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                    <button name="action_pay" type="object" string="Record payment" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_pay_bills_wizard" model="ir.actions.act_window">
        <field name="name">New payment</field>
        <field name="res_model">avea.supplier.pay.bills.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_avea_supplier_pay_bills_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'avea_supplier_workspace': True}</field>
    </record>

</odoo>