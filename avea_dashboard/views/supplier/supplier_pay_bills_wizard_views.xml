<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_supplier_pay_bills_wizard_form" model="ir.ui.view">
        <field name="name">avea.supplier.pay.bills.wizard.form</field>
        <field name="model">avea.supplier.pay.bills.wizard</field>
        <field name="arch" type="xml">
            <form string="New payment" class="o_avea_workspace o_avea_workspace--customer o_avea_workspace--supplier o_avea_pay_bills_wizard">
                <sheet class="o_avea_workspace_sheet o_avea_pay_bills_sheet">
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="available_journal_ids" invisible="1"/>
                    <field name="payment_warning" invisible="1"/>
                    <field name="amount_over_payment" invisible="1"/>
                    <div class="o_avea_workspace_hero o_avea_pay_bills_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">Suppliers</span>
                            <h1 class="o_avea_workspace_title">New payment</h1>
                            <p class="o_avea_workspace_section_subtitle">
                                Enter the EFT amount, then choose how much goes to each open bill.
                                Use <strong>Fill oldest first</strong> as a starting point — you can
                                still edit <strong>Pay now</strong> on any line. Unallocated money
                                stays on the supplier as paid on account.
                            </p>
                        </div>
                    </div>
                    <div class="o_avea_stock_product_panel o_avea_pay_bills_panel">
                        <div class="o_avea_pay_bills_header_grid">
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Supplier</span>
                                <field
                                    name="partner_id"
                                    nolabel="1"
                                    options="{'no_create': True, 'no_open': True}"
                                    placeholder="Choose supplier"
                                    context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">This payment</span>
                                <field name="payment_amount" nolabel="1" widget="monetary" class="o_avea_pay_bills_payment_amount"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Paid on</span>
                                <field name="pay_date" nolabel="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Pay from</span>
                                <field
                                    name="journal_id"
                                    nolabel="1"
                                    options="{'no_create': True, 'no_open': True}"
                                    required="1"
                                    placeholder="Choose cash or bank"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item o_avea_pay_bills_ref_span">
                                <span class="o_avea_workspace_info_label">Reference</span>
                                <field name="payment_ref" nolabel="1" placeholder="EFT reference from the bank"/>
                            </div>
                        </div>
                    </div>
                    <div
                        class="o_avea_pay_bills_summary"
                        invisible="not line_ids"
                    >
                        <div class="o_avea_pay_bills_summary_card">
                            <span class="o_avea_pay_bills_summary_label">This payment</span>
                            <field name="payment_amount" nolabel="1" widget="monetary" readonly="1"/>
                        </div>
                        <div class="o_avea_pay_bills_summary_card">
                            <span class="o_avea_pay_bills_summary_label">Applied to bills</span>
                            <field name="amount_total" nolabel="1" widget="monetary" readonly="1"/>
                        </div>
                        <div class="o_avea_pay_bills_summary_card" invisible="not amount_on_account">
                            <span class="o_avea_pay_bills_summary_label">Left on supplier</span>
                            <field name="amount_on_account" nolabel="1" widget="monetary" readonly="1"/>
                        </div>
                        <div class="o_avea_pay_bills_summary_card">
                            <span class="o_avea_pay_bills_summary_label">Bills with pay</span>
                            <field name="selected_count" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                    <div
                        class="alert alert-warning o_avea_pay_bills_warning"
                        role="alert"
                        invisible="not payment_warning"
                    >
                        <field name="payment_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="o_avea_stock_product_panel o_avea_pay_bills_lines_panel">
                        <div class="o_avea_pay_bills_lines_heading">
                            <h2 class="o_avea_workspace_section_title">Apply to open bills</h2>
                            <button
                                name="action_allocate_oldest_first"
                                type="object"
                                string="Fill oldest first"
                                class="btn btn-secondary btn-sm"
                                invisible="not payment_amount"
                            />
                        </div>
                        <p class="text-muted o_avea_supplier_open_hint" invisible="line_ids">
                            Choose a supplier to see their open bills.
                        </p>
                        <field name="line_ids" nolabel="1" invisible="not line_ids">
                            <list
                                create="false"
                                delete="false"
                                editable="bottom"
                                class="o_avea_pay_bills_lines o_avea_bills_list"
                            >
                                <field name="currency_id" column_invisible="True"/>
                                <field name="bill_id" column_invisible="True"/>
                                <field name="pay" string="Pay"/>
                                <field name="bill_date" string="Date" readonly="1" optional="hide"/>
                                <field name="bill_due" string="Due" readonly="1"/>
                                <field name="bill_label" string="What this is" readonly="1"/>
                                <field name="bill_ref" string="Their invoice" optional="hide" readonly="1"/>
                                <field name="amount_due" string="Still open" widget="monetary" readonly="1"/>
                                <field name="amount" string="Pay now" widget="monetary"/>
                            </list>
                        </field>
                    </div>
                    <footer class="o_avea_stock_footer o_avea_pay_bills_footer">
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                        <button
                            name="action_allocate_oldest_first"
                            type="object"
                            string="Fill oldest first"
                            class="btn btn-outline-secondary"
                            invisible="not payment_amount"
                        />
                        <button name="action_pay" type="object" string="Record payment" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_pay_bills_wizard" model="ir.actions.act_window">
        <field name="name">New payment</field>
        <field name="res_model">avea.supplier.pay.bills.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_avea_supplier_pay_bills_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'avea_supplier_workspace': True}</field>
    </record>

</odoo>