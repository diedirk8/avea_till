<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_supplier_pay_bills_wizard_form" model="ir.ui.view">
        <field name="name">avea.supplier.pay.bills.wizard.form</field>
        <field name="model">avea.supplier.pay.bills.wizard</field>
        <field name="arch" type="xml">
            <form string="New payment" class="o_avea_workspace o_avea_workspace--supplier o_avea_pay_bills_wizard">
                <sheet class="o_avea_pay_bills_sheet">
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="available_journal_ids" invisible="1"/>
                    <field name="payment_warning" invisible="1"/>
                    <field name="amount_over_payment" invisible="1"/>
                    <field name="has_leftover" invisible="1"/>
                    <group>
                        <group string="Payment">
                            <field
                                name="partner_id"
                                options="{'no_create': True, 'no_open': True}"
                                context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}"
                            />
                            <field name="payment_amount" widget="monetary"/>
                            <field
                                name="journal_id"
                                options="{'no_create': True, 'no_open': True}"
                                required="1"
                            />
                        </group>
                        <group>
                            <field name="pay_date"/>
                            <field name="payment_ref" placeholder="Optional — their EFT reference"/>
                            <field name="amount_total" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not payment_warning"
                    >
                        <field name="payment_warning" nolabel="1" readonly="1"/>
                    </div>
                    <group string="Bills to pay" invisible="not line_ids">
                        <div colspan="2" class="o_row o_avea_pay_bills_list_tools">
                            <button
                                name="action_allocate_oldest_first"
                                type="object"
                                string="Fill oldest first"
                                class="btn btn-link btn-sm"
                                invisible="not payment_amount"
                            />
                        </div>
                        <field name="line_ids" nolabel="1" colspan="2">
                            <list
                                create="false"
                                delete="false"
                                editable="bottom"
                                class="o_avea_bills_list"
                            >
                                <field name="currency_id" column_invisible="True"/>
                                <field name="bill_id" column_invisible="True"/>
                                <field name="pay" string="Pay"/>
                                <field name="bill_due" string="Due" readonly="1"/>
                                <field name="bill_label" string="What this is" readonly="1"/>
                                <field name="bill_ref" string="Their invoice" optional="hide" readonly="1"/>
                                <field name="amount_due" string="Still open" widget="monetary" readonly="1"/>
                                <field name="amount" string="Pay now" widget="monetary"/>
                            </list>
                        </field>
                    </group>
                    <p class="text-muted o_avea_supplier_open_hint" invisible="line_ids">
                        Choose a supplier to see open bills.
                    </p>
                    <group string="Left of this payment" invisible="not has_leftover">
                        <field name="amount_on_account" widget="monetary" readonly="1"/>
                        <field
                            name="leftover_action"
                            widget="radio"
                            nolabel="1"
                            colspan="2"
                            options="{'horizontal': false}"
                        />
                    </group>
                    <footer class="o_avea_stock_footer">
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                        <button name="action_pay" type="object" string="Record payment" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_pay_bills_wizard" model="ir.actions.act_window">
        <field name="name">New payment</field>
        <field name="res_model">avea.supplier.pay.bills.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_avea_supplier_pay_bills_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'avea_supplier_workspace': True}</field>
    </record>

</odoo>