<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_bank_reconciliation_list" model="ir.ui.view">
        <field name="name">avea.bank.reconciliation.list</field>
        <field name="model">avea.bank.reconciliation</field>
        <field name="arch" type="xml">
            <list
                string="Bank reconciliations"
                class="o_avea_bank_reconciliation_list"
                js_class="avea_bank_reconciliation_list"
                create="1"
            >
                <field name="name"/>
                <field name="journal_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="opening_balance" string="Opening"/>
                <field name="closing_balance" string="Closing"/>
                <field name="matched_count" string="Matched"/>
                <field name="work_remaining_count" string="Still to do"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'done'"
                    decoration-info="state == 'in_progress'"
                    decoration-muted="state == 'cancelled'"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="write_date" string="Last updated"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_avea_bank_reconciliation_search" model="ir.ui.view">
        <field name="name">avea.bank.reconciliation.search</field>
        <field name="model">avea.bank.reconciliation</field>
        <field name="arch" type="xml">
            <search string="Bank reconciliations">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="account_number"/>
                <filter
                    name="filter_in_progress"
                    string="In progress"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_done"
                    string="Completed"
                    domain="[('state', '=', 'done')]"
                />
                <separator/>
                <filter
                    name="filter_my"
                    string="My reconciliations"
                    domain="[('user_id', '=', uid)]"
                />
            </search>
        </field>
    </record>

    <record id="view_avea_bank_reconcile_line_list" model="ir.ui.view">
        <field name="name">avea.bank.reconcile.line.list</field>
        <field name="model">avea.bank.reconcile.line</field>
        <field name="arch" type="xml">
            <list
                create="false"
                delete="false"
                edit="false"
                limit="80"
                default_order="match_work_rank, bank_date, sequence, id"
                decoration-warning="match_state == 'unmatched'"
                decoration-info="match_state == 'possible'"
                decoration-success="match_state == 'matched'"
                class="o_avea_bank_reconcile_lines"
            >
                <field name="sequence" column_invisible="True"/>
                <field name="match_work_rank" column_invisible="True"/>
                <field name="journal_id" column_invisible="True"/>
                <field name="bank_date" width="96px"/>
                <field name="description"/>
                <field name="reference" optional="hide"/>
                <field name="amount" widget="monetary" optional="hide"/>
                <field name="amount_spent_display" class="o_avea_bank_money"/>
                <field name="amount_received_display" class="o_avea_bank_money"/>
                <field name="is_card_settlement" column_invisible="True"/>
                <field name="match_state" string="Status" widget="badge" readonly="1"
                    decoration-success="match_state == 'matched'"
                    decoration-info="match_state == 'possible'"
                    decoration-warning="match_state == 'unmatched'"
                    decoration-muted="match_state in ('imported', 'skipped')"/>
                <field name="work_hint" string="What to do" readonly="1"/>
                <field name="match_confidence" string="Match %" optional="hide"/>
                <field name="book_match_summary" optional="hide" readonly="1"/>
                <field name="booking_suggestion" optional="hide" readonly="1"/>
                <field name="suggested_expense_account_id" column_invisible="True"/>
                <field name="suggested_income_account_id" column_invisible="True"/>
                <field name="statement_line_id" optional="hide"
                    options="{'no_create': True, 'no_open': True}"
                    readonly="match_state in ('imported', 'skipped')"/>
                <field name="match_locked" column_invisible="True"/>
                <field name="import_action" optional="hide"/>
                <button
                    name="action_accept_line_match"
                    type="object"
                    string="Accept"
                    class="btn-link"
                    invisible="match_state != 'possible'"
                    title="Use this Avea entry for the bank line"
                />
                <button
                    name="action_open_booking_wizard"
                    type="object"
                    string="Record"
                    class="btn-link"
                    invisible="match_state in ('matched', 'imported', 'skipped') or is_card_settlement"
                    title="Create the expense or income for this bank line"
                />
                <button
                    name="action_open_allocate_wizard"
                    type="object"
                    string="Match"
                    class="btn-link"
                    invisible="match_state in ('matched', 'imported', 'skipped') or is_card_settlement"
                    title="Link to an invoice, a bill, or a transfer"
                />
                <button
                    name="action_open_allocate_wizard"
                    type="object"
                    string="Settle"
                    class="btn-link"
                    invisible="match_state in ('matched', 'imported', 'skipped') or not is_card_settlement"
                    title="Enter the card sales before Capitec or Yoco took their fee"
                    context="{'default_mode': 'settlement'}"
                />
                <field name="match_hint" column_invisible="True"/>
                <field name="candidate_statement_line_ids" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_avea_bank_reconcile_book_line_list" model="ir.ui.view">
        <field name="name">avea.bank.reconcile.book.line.list</field>
        <field name="model">avea.bank.reconcile.book.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="book_date"/>
                <field name="label"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_avea_bank_reconciliation_form" model="ir.ui.view">
        <field name="name">avea.bank.reconciliation.form</field>
        <field name="model">avea.bank.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Bank reconciliation" class="o_avea_workspace o_avea_workspace--overview o_avea_workspace--bank-recon-form o_avea_bank_reconcile_wizard" js_class="avea_bank_reconciliation_form">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="name" invisible="1"/>
                <field name="ready_card_batch_count" invisible="1"/>
                <field name="possible_match_count" invisible="1"/>
                <field name="unmatched_bank_count" invisible="1"/>
                <field name="matched_count" invisible="1"/>
                <field name="can_complete" invisible="1"/>
                <field name="is_balanced" invisible="1"/>
                <field name="next_step_kind" invisible="1"/>
                <field name="has_display_lines" invisible="1"/>
                <field name="has_previous_statement" invisible="1"/>
                <field name="show_prior_outstanding_option" invisible="1"/>
                <field name="unmatched_card_batch_count" invisible="1"/>
                <field name="has_merchant_payouts" invisible="1"/>
                <field name="balances_from_file" invisible="1"/>
                <field name="brought_forward" invisible="1"/>
                <field name="orphan_book_count" invisible="1"/>
                <header>
                    <button
                        name="action_parse_statement"
                        string="Load &amp; match"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                        data-hotkey="q"
                    />
                    <button
                        name="action_refresh_matches"
                        string="Refresh matches"
                        type="object"
                        invisible="state != 'in_progress'"
                    />
                    <button
                        name="action_accept_possible_matches"
                        string="Accept possible matches"
                        type="object"
                        invisible="state != 'in_progress' or possible_match_count == 0"
                    />
                    <button
                        name="action_settle_card_batches"
                        string="Settle card batches"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'in_progress' or ready_card_batch_count == 0"
                    />
                    <button
                        name="action_apply_reconciliation"
                        string="Complete reconciliation"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'in_progress'"
                        data-hotkey="shift+q"
                    />
                    <button
                        name="action_cancel_reconciliation"
                        string="Cancel"
                        type="object"
                        invisible="state not in ('draft', 'in_progress')"
                    />
                    <button
                        name="action_open_list"
                        string="All reconciliations"
                        type="object"
                        class="btn-secondary"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet class="o_avea_workspace_sheet">
                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <button name="action_open_list" type="object" string="Back to reconciliations" class="btn btn-link o_avea_account_back_btn"/>
                            <span class="o_avea_workspace_eyebrow">Money</span>
                            <h1 class="o_avea_workspace_title" invisible="state != 'draft'">New bank reconciliation</h1>
                            <h1 class="o_avea_workspace_title" invisible="state == 'draft'">Bank reconciliation</h1>
                            <div class="o_avea_period_range" invisible="state == 'draft'">
                                <field name="period_range_display" nolabel="1" readonly="1"/>
                            </div>
                            <p class="o_avea_workspace_section_subtitle" invisible="state != 'draft' or has_previous_statement">
                                Three files for the same month: the FNB statement, the Yoco payouts CSV,
                                and the Capitec merchant statement. Work is saved — come back anytime.
                            </p>
                            <p class="o_avea_workspace_section_subtitle" invisible="state != 'draft' or not has_previous_statement">
                                This recon starts from the last completed statement. Opening is that
                                closing balance. Upload the next FNB PDF plus the Yoco and Capitec files.
                            </p>
                        </div>
                        <div class="o_avea_workspace_hero_stats" invisible="state == 'draft'">
                            <div class="o_avea_workspace_hero_stat o_avea_workspace_hero_stat--primary o_avea_bank_recon_stat--ok" invisible="not is_balanced">
                                <span class="o_avea_workspace_hero_stat_label">Difference</span>
                                <field name="difference_headline" nolabel="1" readonly="1" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                            <div class="o_avea_workspace_hero_stat o_avea_workspace_hero_stat--primary o_avea_bank_recon_stat--warn" invisible="is_balanced">
                                <span class="o_avea_workspace_hero_stat_label">Difference</span>
                                <field name="statement_difference" nolabel="1" readonly="1" widget="monetary" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                            <div class="o_avea_workspace_hero_stat">
                                <span class="o_avea_workspace_hero_stat_label">Still to do</span>
                                <field name="work_remaining_count" nolabel="1" readonly="1" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                            <div class="o_avea_workspace_hero_stat">
                                <span class="o_avea_workspace_hero_stat_label">Matched</span>
                                <field name="matched_display" nolabel="1" readonly="1" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                            <div class="o_avea_workspace_hero_stat">
                                <span class="o_avea_workspace_hero_stat_label">Bank closing</span>
                                <field name="closing_balance" nolabel="1" readonly="1" widget="monetary" class="o_avea_workspace_hero_stat_value"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_bank_recon_next" invisible="not next_step_message">
                        <div class="o_avea_bank_recon_next_copy">
                            <strong><field name="next_step_title" nolabel="1" readonly="1"/></strong>
                            <field name="next_step_message" nolabel="1" readonly="1"/>
                        </div>
                        <div class="o_avea_bank_recon_next_actions">
                            <button
                                name="action_parse_statement"
                                string="Load &amp; match"
                                type="object"
                                class="btn btn-primary"
                                invisible="state != 'draft'"
                            />
                            <button
                                name="action_settle_card_batches"
                                string="Settle card batches"
                                type="object"
                                class="btn btn-primary"
                                invisible="next_step_kind != 'settle_cards'"
                            />
                            <button
                                name="action_accept_possible_matches"
                                string="Accept possible matches"
                                type="object"
                                class="btn btn-primary"
                                invisible="next_step_kind != 'accept_matches'"
                            />
                            <button
                                name="action_apply_reconciliation"
                                string="Complete reconciliation"
                                type="object"
                                class="btn btn-primary"
                                invisible="next_step_kind != 'complete'"
                            />
                            <button
                                name="action_refresh_matches"
                                string="Refresh matches"
                                type="object"
                                class="btn btn-secondary"
                                invisible="state != 'in_progress'"
                            />
                            <button
                                name="action_cancel_reconciliation"
                                string="Cancel"
                                type="object"
                                class="btn btn-link"
                                invisible="state not in ('draft', 'in_progress')"
                            />
                        </div>
                    </div>

                    <div class="alert alert-info" role="status" invisible="not brought_forward">
                        Opening and closing come from the FNB statement for this month.
                        The line-by-line tick was done on the May–August working papers, not
                        by loading every bank line into this screen. September onwards is a live recon.
                    </div>

                    <div class="o_avea_account_panel o_avea_bank_recon_setup" invisible="state != 'draft' or not has_previous_statement">
                        <h2 class="o_avea_workspace_section_title">Last completed statement</h2>
                        <p class="o_avea_account_panel_hint">
                            New recon starts here. After you load the next FNB file, Avea checks
                            that the file opening matches this closing.
                        </p>
                        <div class="o_avea_account_fields">
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Last statement</span>
                                <field name="previous_statement_label" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Last closing</span>
                                <field name="previous_closing_balance" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">This opening</span>
                                <field name="opening_balance" nolabel="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">From</span>
                                <field name="date_from" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_account_panel o_avea_bank_recon_setup" invisible="state != 'draft'">
                        <h2 class="o_avea_workspace_section_title">1. Bank account</h2>
                        <div class="o_avea_account_fields">
                            <div class="o_avea_workspace_info_item o_avea_account_field--wide">
                                <span class="o_avea_workspace_info_label">Account</span>
                                <field name="journal_id" nolabel="1" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_avea_account_panel o_avea_bank_recon_setup" invisible="state != 'draft'">
                        <h2 class="o_avea_workspace_section_title">2. FNB statement</h2>
                        <p class="o_avea_account_panel_hint">
                            Gold Business Account PDF, or a CSV / OFX from FNB. Avea reads the
                            statement period from this file — you can change the dates after it loads
                            if this is a part-month.
                        </p>
                        <div class="o_avea_account_fields">
                            <div class="o_avea_workspace_info_item o_avea_account_field--wide">
                                <span class="o_avea_workspace_info_label">Statement file</span>
                                <field
                                    name="statement_file"
                                    filename="statement_filename"
                                    nolabel="1"
                                />
                                <field name="statement_filename" invisible="1"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_avea_account_panel o_avea_bank_recon_setup" invisible="state != 'draft'">
                        <h2 class="o_avea_workspace_section_title">3. Card machine files</h2>
                        <p class="o_avea_account_panel_hint">
                            Same month as the FNB statement. Without these, you have to type every
                            Capitec and Yoco batch by hand.
                        </p>
                        <field name="merchant_file_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="datas" filename="filename" string="Yoco CSV or Capitec PDF"/>
                                <field name="filename"/>
                            </list>
                        </field>
                    </div>

                    <div class="o_avea_account_panel" invisible="state == 'draft'">
                        <h2 class="o_avea_workspace_section_title">Statement period</h2>
                        <p class="o_avea_account_panel_hint" invisible="state != 'in_progress'">
                            Taken from the bank file. Change the dates for a part-month
                            (for example 13 May go-live), then click <strong>Refresh matches</strong>.
                        </p>
                        <div class="o_avea_account_fields">
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">From</span>
                                <field name="date_from" nolabel="1" readonly="state in ('done', 'cancelled')"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">To</span>
                                <field name="date_to" nolabel="1" readonly="state in ('done', 'cancelled')"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Bank opening</span>
                                <field name="opening_balance" nolabel="1" readonly="state in ('done', 'cancelled')" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Bank closing</span>
                                <field name="closing_balance" nolabel="1" readonly="state in ('done', 'cancelled')" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Account</span>
                                <field name="journal_id" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Account number</span>
                                <field name="account_number" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning" role="status" invisible="state == 'draft' or not balance_warning">
                        <field name="balance_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="state == 'draft' or not merchant_warning">
                        <field name="merchant_warning" nolabel="1" readonly="1"/>
                    </div>

                    <div class="o_avea_account_panel" invisible="state == 'draft'">
                        <h2 class="o_avea_workspace_section_title">How the difference is calculated</h2>
                        <div class="o_avea_account_fields">
                            <div class="o_avea_workspace_info_item" invisible="not has_previous_statement">
                                <span class="o_avea_workspace_info_label">Previous statement</span>
                                <field name="previous_closing_balance" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">In Avea</span>
                                <field name="gl_balance" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Not on this statement yet</span>
                                <field name="outstanding_amount" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Avea after those items</span>
                                <field name="adjusted_book_balance" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item" invisible="not show_prior_outstanding_option">
                                <span class="o_avea_workspace_info_label">Older entries still missing from the bank</span>
                                <field name="prior_items_outstanding" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_account_panel" invisible="state == 'draft'">
                        <h2 class="o_avea_workspace_section_title">Card machines</h2>
                        <p class="o_avea_account_panel_hint">
                            Add the Yoco CSV and Capitec merchant PDF here, even after the FNB
                            statement is loaded. Avea matches them as soon as you attach them.
                            Till card sales should be close to those files.
                        </p>
                        <field name="merchant_file_ids" nolabel="1" invisible="state == 'done'">
                            <list editable="bottom">
                                <field name="datas" filename="filename" string="Yoco CSV or Capitec PDF"/>
                                <field name="filename" string="Filename"/>
                                <field name="provider"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="period_warning"/>
                            </list>
                        </field>
                        <div class="o_avea_account_fields">
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Till card sales</span>
                                <field name="till_card_sales" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">On the machines</span>
                                <field name="merchant_card_sales" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Till vs machines</span>
                                <field name="card_sales_gap" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Banked after fees</span>
                                <field name="card_banked" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Card fees</span>
                                <field name="merchant_card_fees" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Yoco capital repaid</span>
                                <field name="merchant_card_capital" nolabel="1" readonly="1" widget="monetary"/>
                            </div>
                        </div>
                    </div>

                    <notebook invisible="state not in ('in_progress', 'done')">
                        <page string="Bank statement" name="bank_lines">
                            <p class="text-muted o_avea_bank_recon_hint" invisible="state == 'done'">
                                Each row is one bank line.
                                <strong>Record</strong> creates the expense or income.
                                <strong>Match</strong> links an invoice, a bill, or a transfer.
                                <strong>Settle</strong> is one Capitec or Yoco deposit — prefer
                                <strong>Settle card batches</strong> when the machine files are attached.
                            </p>
                            <div class="o_avea_bank_recon_filters" invisible="state != 'in_progress'">
                                <span class="o_avea_workspace_info_label">Show</span>
                                <field name="line_filter" nolabel="1" widget="radio" options="{'horizontal': true}"/>
                                <span class="o_avea_bank_recon_filter_count">
                                    <field name="display_line_count" class="oe_inline" readonly="1"/>
                                    of
                                    <field name="import_count" class="oe_inline" readonly="1"/>
                                    lines
                                </span>
                            </div>
                            <p class="text-muted" invisible="has_display_lines or not empty_filter_message">
                                <field name="empty_filter_message" nolabel="1" readonly="1"/>
                            </p>
                            <field
                                name="display_line_ids"
                                nolabel="1"
                                widget="many2many"
                                mode="list"
                                options="{'no_create': True, 'no_open': True}"
                                context="{'avea_bank_reconcile_labels': True}"
                                invisible="not has_display_lines"
                            >
                                <list
                                    create="false"
                                    delete="false"
                                    edit="false"
                                    limit="80"
                                    default_order="match_work_rank, bank_date, sequence, id"
                                    decoration-warning="match_state == 'unmatched'"
                                    decoration-info="match_state == 'possible'"
                                    decoration-success="match_state == 'matched'"
                                    class="o_avea_bank_reconcile_lines"
                                >
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="match_work_rank" column_invisible="True"/>
                                    <field name="journal_id" column_invisible="True"/>
                                    <field name="bank_date" width="96px"/>
                                    <field name="description"/>
                                    <field name="reference" optional="hide"/>
                                    <field name="amount" widget="monetary" optional="hide"/>
                                    <field name="amount_spent_display" class="o_avea_bank_money"/>
                                    <field name="amount_received_display" class="o_avea_bank_money"/>
                                    <field name="is_card_settlement" column_invisible="True"/>
                                    <field name="match_state" string="Status" widget="badge" readonly="1"
                                        decoration-success="match_state == 'matched'"
                                        decoration-info="match_state == 'possible'"
                                        decoration-warning="match_state == 'unmatched'"
                                        decoration-muted="match_state in ('imported', 'skipped')"/>
                                    <field name="work_hint" string="What to do" readonly="1"/>
                                    <field name="match_confidence" string="Match %" optional="hide"/>
                                    <field name="book_match_summary" optional="hide" readonly="1"/>
                                    <field name="booking_suggestion" optional="hide" readonly="1"/>
                                    <field name="suggested_expense_account_id" column_invisible="True"/>
                                    <field name="suggested_income_account_id" column_invisible="True"/>
                                    <field name="statement_line_id" optional="hide"
                                        options="{'no_create': True, 'no_open': True}"/>
                                    <field name="match_locked" column_invisible="True"/>
                                    <field name="import_action" optional="hide"/>
                                    <button
                                        name="action_accept_line_match"
                                        type="object"
                                        string="Accept"
                                        class="btn-link"
                                        invisible="match_state != 'possible'"
                                        title="Use this Avea entry for the bank line"
                                    />
                                    <button
                                        name="action_open_booking_wizard"
                                        type="object"
                                        string="Record"
                                        class="btn-link"
                                        invisible="match_state in ('matched', 'imported', 'skipped') or is_card_settlement"
                                        title="Create the expense or income for this bank line"
                                    />
                                    <button
                                        name="action_open_allocate_wizard"
                                        type="object"
                                        string="Match"
                                        class="btn-link"
                                        invisible="match_state in ('matched', 'imported', 'skipped') or is_card_settlement"
                                        title="Link to an invoice, a bill, or a transfer"
                                    />
                                    <button
                                        name="action_open_allocate_wizard"
                                        type="object"
                                        string="Settle"
                                        class="btn-link"
                                        invisible="match_state in ('matched', 'imported', 'skipped') or not is_card_settlement"
                                        title="Enter the card sales before Capitec or Yoco took their fee"
                                        context="{'default_mode': 'settlement'}"
                                    />
                                    <field name="match_hint" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Card machines" name="merchant_payouts">
                            <p class="text-muted">
                                Each row is one Yoco or Capitec payout from the files in
                                <strong>Card machines</strong> above. The amount the bank received
                                is after fees. Yoco capital is a loan repayment, not shop sales.
                            </p>
                            <field name="merchant_payout_ids" nolabel="1">
                                <list create="false" delete="false" edit="false">
                                    <field name="payout_date"/>
                                    <field name="provider"/>
                                    <field name="gross_amount" widget="monetary"/>
                                    <field name="fee_amount" widget="monetary"/>
                                    <field name="capital_amount" widget="monetary"/>
                                    <field name="net_amount" widget="monetary" string="Bank received"/>
                                    <field name="on_this_statement"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Missing from bank" name="book_lines">
                            <p class="text-muted">
                                Payments already in Avea that this statement does not show.
                                They stay outstanding until a later statement clears them.
                            </p>
                            <field name="book_line_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_bank_reconciliation" model="ir.actions.act_window">
        <field name="name">Bank reconciliations</field>
        <field name="res_model">avea.bank.reconciliation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_avea_bank_reconciliation_search"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bank reconciliations yet
            </p>
            <p>
                Click <strong>New reconciliation</strong> above the list (or use
                <strong>Money → New bank reconciliation</strong>), then upload the FNB
                statement plus the Yoco and Capitec files for that month.
            </p>
        </field>
    </record>

    <record id="action_avea_new_bank_reconciliation" model="ir.actions.server">
        <field name="name">New bank reconciliation</field>
        <field name="model_id" ref="model_avea_bank_reconciliation"/>
        <field name="state">code</field>
        <field name="code">action = model.action_new_reconciliation()</field>
    </record>

    <record id="action_avea_bank_reconcile_wizard" model="ir.actions.server">
        <field name="name">Bank reconciliation</field>
        <field name="model_id" ref="model_avea_bank_reconcile_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_wizard()</field>
    </record>

</odoo>
