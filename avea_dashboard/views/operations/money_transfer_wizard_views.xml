<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_money_transfer_wizard_form" model="ir.ui.view">
        <field name="name">avea.money.transfer.wizard.form</field>
        <field name="model">avea.money.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Money" class="o_avea_wizard">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="status" invisible="state == 'confirm'">
                    Move money between company accounts. This is not an expense.
                </div>
                <div class="alert alert-info" role="status" invisible="state != 'confirm'">
                    <p class="mb-1">
                        <strong>
                            <field name="confirmation_message" nolabel="1"/>
                        </strong>
                    </p>
                    <p class="mb-0">
                        This is a transfer between company money accounts. It is not an expense.
                    </p>
                </div>
                <group invisible="state == 'confirm'">
                    <group>
                        <field
                            name="from_journal_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="to_journal_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="transfer_date"/>
                        <field name="reference" placeholder="Optional reference"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group invisible="state == 'confirm'">
                    <field name="notes" placeholder="Optional notes"/>
                </group>
                <group invisible="state != 'confirm'">
                    <group>
                        <field
                            name="from_journal_id"
                            readonly="1"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="to_journal_id"
                            readonly="1"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="transfer_date" readonly="1"/>
                        <field name="reference" readonly="1"/>
                    </group>
                </group>
                <group invisible="state != 'confirm'">
                    <field name="notes" readonly="1"/>
                </group>
                <footer>
                    <button
                        name="action_review_transfer"
                        string="Review Transfer"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="state == 'confirm'"
                    />
                    <button
                        name="action_confirm_transfer"
                        string="Transfer Money"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="state != 'confirm'"
                    />
                    <button
                        name="action_back"
                        string="Back"
                        type="object"
                        invisible="state != 'confirm'"
                    />
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_money_transfer_wizard" model="ir.actions.server">
        <field name="name">Transfer Money</field>
        <field name="model_id" ref="model_avea_money_transfer_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_wizard()</field>
    </record>

</odoo>
