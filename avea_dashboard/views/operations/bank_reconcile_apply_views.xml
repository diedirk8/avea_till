<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_bank_reconcile_apply_form" model="ir.ui.view">
        <field name="name">avea.bank.reconcile.apply.form</field>
        <field name="model">avea.bank.reconcile.apply</field>
        <field name="arch" type="xml">
            <form string="Match this bank line">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="journal_id" invisible="1"/>
                    <field name="available_move_ids" invisible="1"/>
                    <field name="available_transfer_journal_ids" invisible="1"/>
                    <field name="is_money_out" invisible="1"/>
                    <field name="description" readonly="1"/>
                    <field name="amount" readonly="1" widget="monetary"/>
                    <field name="mode" widget="radio"/>
                </group>
                <group invisible="mode != 'match' or not is_money_out">
                    <field
                        name="partner_id"
                        options="{'no_create': True, 'no_open': True}"
                        placeholder="Choose supplier"
                    />
                </group>
                <field
                    name="allocation_line_ids"
                    nolabel="1"
                    invisible="mode != 'match' or not is_money_out"
                >
                    <list create="false" delete="false" editable="bottom">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="bill_id" column_invisible="True"/>
                        <field name="pay" string="Pay"/>
                        <field name="bill_date" string="Date" readonly="1"/>
                        <field name="bill_label" string="What this is" readonly="1"/>
                        <field name="bill_ref" string="Their invoice" readonly="1"/>
                        <field name="amount_due" string="Still open" widget="monetary" readonly="1"/>
                        <field name="amount" string="Apply" widget="monetary"/>
                    </list>
                </field>
                <group invisible="mode != 'match' or not is_money_out">
                    <field name="amount_applied" readonly="1" widget="monetary"/>
                    <field name="amount_on_account" readonly="1" widget="monetary"/>
                </group>
                <group invisible="mode != 'match'">
                    <field
                        name="move_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                        placeholder="Already-paid invoice or receive to link"
                    />
                    <field name="open_amount" readonly="1" widget="monetary"/>
                    <field name="paid_document_hint" readonly="1" nolabel="1" invisible="not paid_document_hint"/>
                </group>
                <p class="text-muted" invisible="mode != 'match'">
                    Choose the supplier, then type how much of this EFT each open bill
                    should take — this week’s invoice and old arrears can share one
                    payment. Extra stays on the supplier. Already-paid bills are linked
                    without paying them again.
                </p>
                <group invisible="mode != 'settlement'">
                    <field name="settlement_gross"/>
                    <field name="settlement_capital"/>
                    <field name="settlement_fee" readonly="1" widget="monetary"/>
                    <field name="fee_account_id" options="{'no_create': True}"/>
                    <field name="capital_account_id" options="{'no_create': True}"/>
                    <field name="settlement_hint" readonly="1" nolabel="1"/>
                </group>
                <p class="text-muted" invisible="mode != 'settlement'">
                    Capitec and Yoco pay into the bank after fees (and Yoco capital) are taken
                    off, so the statement amount is smaller than the till. If you attached the
                    machine file, Avea fills the sales, fee, and capital from it. The fee goes
                    to Bank Charges. Yoco capital goes to the loan account, not to fees.
                </p>
                <group invisible="mode != 'split'">
                    <field name="split_total" readonly="1" widget="monetary"/>
                </group>
                <field
                    name="split_line_ids"
                    nolabel="1"
                    invisible="mode != 'split'"
                >
                    <list editable="bottom">
                        <field name="company_id" column_invisible="True"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="account_id"/>
                        <field name="name"/>
                        <field name="amount" widget="monetary"/>
                    </list>
                </field>
                <p class="text-muted" invisible="mode != 'split'">
                    Use this when one bank payment covers more than one account.
                    The amounts must add up to the bank line. Receivable, payable,
                    and bank accounts stay on Match and Transfer.
                </p>
                <group invisible="mode != 'transfer'">
                    <field name="transfer_journal_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <p class="text-muted" invisible="mode != 'transfer'">
                    Money out leaves this account. Money in arrived from the other account.
                    The other side stays outstanding until you reconcile that account.
                </p>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
