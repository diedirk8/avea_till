<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_manual_journal_wizard_form" model="ir.ui.view">
        <field name="name">avea.manual.journal.wizard.form</field>
        <field name="model">avea.manual.journal.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Journal Entry" class="o_avea_wizard">
                <field name="company_id" invisible="1"/>
                <div class="alert alert-info" role="status">
                    Record a debit and a credit. This posts a miscellaneous journal entry.
                </div>
                <group>
                    <group>
                        <field name="date"/>
                        <field
                            name="description"
                            placeholder="e.g. Salary Advance"
                        />
                        <field name="amount"/>
                    </group>
                    <group>
                        <field
                            name="debit_account_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="credit_account_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_post_journal"
                        string="Post Journal"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_manual_journal_wizard" model="ir.actions.server">
        <field name="name">Manual Journal</field>
        <field name="model_id" ref="model_avea_manual_journal_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_wizard()</field>
    </record>

</odoo>
