<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_operational_expense_wizard_form" model="ir.ui.view">
        <field name="name">avea.operational.expense.wizard.form</field>
        <field name="model">avea.operational.expense.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Operational Expense" class="o_avea_wizard">
                <field name="company_id" invisible="1"/>
                <field name="available_journal_ids" invisible="1"/>
                <field name="available_expense_account_ids" invisible="1"/>
                <field name="bank_reconcile_line_id" invisible="1"/>
                <field name="booking_partner_role" invisible="1"/>
                <group>
                    <field
                        name="what_for"
                        widget="radio"
                        options="{'horizontal': true}"
                    />
                </group>
                <div
                    class="alert alert-secondary mb-0 py-2"
                    role="status"
                    invisible="not partner_hint"
                >
                    <field name="partner_hint" nolabel="1" readonly="1"/>
                </div>
                <div
                    class="alert alert-secondary mb-0 py-2"
                    role="status"
                    invisible="not employee_advance_help"
                >
                    <field name="employee_advance_help" nolabel="1" readonly="1"/>
                    <field name="employee_advance_outstanding" invisible="1"/>
                    <field name="employee_salary_including_advances" invisible="1"/>
                </div>
                <group>
                    <group>
                        <field
                            name="partner_id"
                            string="Paid to"
                            widget="avea_expense_supplier_many2one"
                            placeholder="Search payee"
                            options="{'no_open': True, 'no_create_edit': True}"
                            context="{'res_partner_search_mode': what_for == 'expense' and 'supplier' or '', 'avea_operational_expense_supplier': what_for == 'expense', 'avea_expense_payee_person': what_for in ('salary', 'advance') or booking_partner_role == 'employee', 'avea_staff_payee': what_for in ('salary', 'advance') or booking_partner_role == 'employee', 'default_supplier_rank': what_for == 'expense' and 1 or 0, 'default_avea_is_employee': what_for in ('salary', 'advance'), 'default_is_company': what_for == 'expense'}"
                        />
                        <field name="expense_date"/>
                        <field
                            name="document_ref"
                            placeholder="Invoice or slip number"
                        />
                    </group>
                    <group>
                        <field
                            name="expense_account_id"
                            invisible="what_for in ('salary', 'advance')"
                            required="what_for == 'expense'"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="amount"/>
                        <field
                            name="paid_from_journal_id"
                            options="{'no_create': True, 'no_open': True}"
                            placeholder="Choose cash or bank"
                        />
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group>
                    <field name="description" placeholder="e.g. Vegetables"/>
                </group>
                <footer>
                    <button
                        name="action_record_expense"
                        string="Record Expense"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_operational_expense_wizard" model="ir.actions.server">
        <field name="name">Add Operational Expense</field>
        <field name="model_id" ref="model_avea_operational_expense_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_wizard()</field>
    </record>

</odoo>
