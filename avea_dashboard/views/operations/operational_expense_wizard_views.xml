<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_operational_expense_wizard_form" model="ir.ui.view">
        <field name="name">avea.operational.expense.wizard.form</field>
        <field name="model">avea.operational.expense.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Operational Expense" class="o_avea_wizard">
                <field name="company_id" invisible="1"/>
                <field name="available_journal_ids" invisible="1"/>
                <group>
                    <group>
                        <div class="o_row o_avea_wizard_supplier_toggle">
                            <field name="add_new_supplier" nolabel="1"/>
                            <label for="add_new_supplier">Add a new supplier</label>
                        </div>
                        <field
                            name="partner_id"
                            invisible="add_new_supplier"
                            required="not add_new_supplier"
                            placeholder="Search supplier or create a new one"
                            options="{'no_open': True, 'no_create_edit': True}"
                            context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1, 'default_is_company': True}"
                        />
                        <field
                            name="new_supplier_name"
                            invisible="not add_new_supplier"
                            required="add_new_supplier"
                            placeholder="Supplier name"
                        />
                        <field
                            name="new_supplier_vat"
                            invisible="not add_new_supplier"
                            placeholder="Tax number (optional)"
                        />
                        <field name="expense_date"/>
                        <field
                            name="document_ref"
                            placeholder="Invoice or slip number"
                        />
                    </group>
                    <group>
                        <field
                            name="expense_account_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="amount"/>
                        <field
                            name="paid_from_journal_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group>
                    <field name="description" placeholder="e.g. Vegetables"/>
                </group>
                <footer>
                    <button
                        name="action_record_expense"
                        string="Record Expense"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_operational_expense_wizard" model="ir.actions.server">
        <field name="name">Add Operational Expense</field>
        <field name="model_id" ref="model_avea_operational_expense_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_wizard()</field>
    </record>

</odoo>
