<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_stock_picking_avea_return_search" model="ir.ui.view">
        <field name="name">stock.picking.avea.return.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Receipts">
                <field name="name" string="Receipt"/>
                <field name="avea_supplier_invoice_ref" string="Supplier invoice"/>
                <field name="partner_id" string="Supplier"/>
                <field name="origin"/>
            </search>
        </field>
    </record>

    <record id="view_avea_stock_return_form" model="ir.ui.view">
        <field name="name">avea.stock.return.form</field>
        <field name="model">avea.stock.return</field>
        <field name="arch" type="xml">
            <form string="Return Stock" create="false" duplicate="false" delete="false" class="o_avea_workspace o_avea_workspace--stock">
                <sheet class="o_avea_workspace_sheet">
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">Stock</span>
                            <h1 class="o_avea_workspace_title">Return Stock</h1>
                            <p class="o_avea_workspace_section_subtitle">
                                Choose a previous receipt and return products to the supplier.
                            </p>
                        </div>
                    </div>

                    <div class="o_avea_stock_panel">
                        <h2 class="o_avea_workspace_section_title">Receipt</h2>
                        <p class="o_avea_workspace_section_subtitle mb-3">
                            Use the supplier invoice number, or search the receipt list by invoice, supplier, or WH/IN number.
                        </p>
                        <div class="o_avea_workspace_info_grid o_avea_stock_side_grid">
                            <div class="o_avea_workspace_info_item o_avea_stock_return_lookup">
                                <span class="o_avea_workspace_info_label">Supplier invoice number</span>
                                <div class="d-flex flex-wrap gap-2 align-items-start">
                                    <field name="lookup_invoice_number" nolabel="1" class="flex-grow-1" placeholder="e.g. INV0050795"/>
                                    <button
                                        name="action_find_receipt_by_invoice"
                                        type="object"
                                        string="Find receipt"
                                        class="btn btn-secondary"
                                    />
                                </div>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Supplier (optional)</span>
                                <field
                                    name="lookup_partner_id"
                                    nolabel="1"
                                    options="{'no_create': True}"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item o_avea_sales_platform_field--wide">
                                <span class="o_avea_workspace_info_label">Receipt</span>
                                <field
                                    name="picking_id"
                                    nolabel="1"
                                    options="{'no_create': True, 'no_open': True, 'search_view_ref': 'avea_till.view_stock_picking_avea_return_search'}"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Supplier</span>
                                <field name="partner_id" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Invoice number</span>
                                <field name="invoice_number" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Receipt date</span>
                                <field name="receipt_date" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Return date</span>
                                <field name="return_date" nolabel="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item" groups="base.group_multi_company">
                                <span class="o_avea_workspace_info_label">Company</span>
                                <field name="company_id" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_stock_panel o_avea_stock_panel--products">
                        <h2 class="o_avea_workspace_section_title">Products to return</h2>
                        <div class="o_avea_stock_list_surface">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false" class="o_avea_stock_return_list">
                                    <field name="move_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="qty_received"/>
                                    <field name="qty_available"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <div class="o_avea_stock_footer">
                        <button
                            name="action_return_stock"
                            type="object"
                            string="Return Stock"
                            class="btn-primary"
                            data-hotkey="q"
                        />
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_stock_return" model="ir.actions.server">
        <field name="name">Return Stock</field>
        <field name="model_id" ref="model_avea_stock_return"/>
        <field name="state">code</field>
        <field name="code">action = env['avea.stock.return'].action_open_return()</field>
    </record>

</odoo>
