<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_stock_internal_use_form" model="ir.ui.view">
        <field name="name">avea.stock.internal_use.form</field>
        <field name="model">avea.stock.internal_use</field>
        <field name="arch" type="xml">
            <form string="Scrap Stock" create="false" duplicate="false" delete="false" class="o_avea_workspace o_avea_workspace--stock">
                <sheet class="o_avea_workspace_sheet">
                    <field name="company_id" invisible="1"/>

                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">Stock</span>
                            <h1 class="o_avea_workspace_title">Scrap Stock</h1>
                            <p class="o_avea_workspace_section_subtitle">
                                Remove damaged, expired, demo, or internally used products from on-hand stock.
                            </p>
                        </div>
                    </div>

                    <div class="o_avea_stock_panel">
                        <h2 class="o_avea_workspace_section_title">Details</h2>
                        <div class="o_avea_workspace_info_grid o_avea_stock_side_grid">
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Date</span>
                                <field name="use_date" nolabel="1"/>
                            </div>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Scrapped by</span>
                                <field
                                    name="user_id"
                                    nolabel="1"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item o_avea_sales_platform_field--wide">
                                <span class="o_avea_workspace_info_label">From location</span>
                                <field name="location_id" nolabel="1" options="{'no_create': True}"/>
                            </div>
                            <div class="o_avea_workspace_info_item o_avea_sales_platform_field--wide">
                                <span class="o_avea_workspace_info_label">Reason</span>
                                <field
                                    name="reason_tag_id"
                                    nolabel="1"
                                    required="1"
                                    placeholder="Select a reason, or type to add one"
                                    options="{'no_quick_create': False, 'no_create_edit': False, 'no_open': True}"
                                />
                            </div>
                            <div class="o_avea_workspace_info_item o_avea_sales_platform_field--wide">
                                <span class="o_avea_workspace_info_label">Notes</span>
                                <field name="notes" nolabel="1" placeholder="e.g. Demo bird cage, broken bag"/>
                            </div>
                            <div class="o_avea_workspace_info_item" groups="base.group_multi_company">
                                <span class="o_avea_workspace_info_label">Company</span>
                                <field name="company_id" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_stock_panel o_avea_stock_panel--products">
                        <h2 class="o_avea_workspace_section_title">Products to scrap</h2>
                        <p class="o_avea_workspace_section_subtitle mb-3">
                            Add each product and quantity to remove from stock. Tracked items need a lot or serial number.
                        </p>
                        <div class="o_avea_stock_list_surface">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" class="o_avea_stock_internal_use_list">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="product_tracking" column_invisible="True"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="qty_available" readonly="1"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <div class="o_avea_stock_footer">
                        <button
                            name="action_cancel_scrap"
                            type="object"
                            special="cancel"
                            string="Cancel"
                            class="btn-secondary"
                            data-hotkey="x"
                        />
                        <button
                            name="action_use_stock"
                            type="object"
                            string="Scrap Stock"
                            class="btn-primary"
                            data-hotkey="q"
                        />
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_stock_internal_use" model="ir.actions.server">
        <field name="name">Scrap Stock</field>
        <field name="model_id" ref="model_avea_stock_internal_use"/>
        <field name="state">code</field>
        <field name="code">action = env['avea.stock.internal_use'].action_open_internal_use()</field>
    </record>

</odoo>
