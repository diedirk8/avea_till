<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <delete model="ir.actions.act_window" id="action_avea_credit_reports"/>
    <delete model="ir.ui.view" id="view_avea_credit_reports_form"/>

    <record id="view_avea_credit_statement_wizard_form" model="ir.ui.view">
        <field name="name">avea.credit.statement.wizard.form</field>
        <field name="model">avea.credit.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Credit Statement" class="o_avea_wizard">
                <group>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_credit_statement_wizard" model="ir.actions.server">
        <field name="name">Customer Credit Statement</field>
        <field name="model_id" ref="model_avea_credit_statement_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env['avea.credit.statement.wizard'].action_open_wizard()</field>
    </record>

    <record id="view_avea_credit_outstanding_wizard_form" model="ir.ui.view">
        <field name="name">avea.credit.outstanding.wizard.form</field>
        <field name="model">avea.credit.outstanding.wizard</field>
        <field name="arch" type="xml">
            <form string="Outstanding Customer Credit" class="o_avea_wizard">
                <group>
                    <field name="minimum_balance"/>
                    <field name="date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_credit_outstanding_wizard" model="ir.actions.server">
        <field name="name">Outstanding Customer Credit</field>
        <field name="model_id" ref="model_avea_credit_outstanding_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env['avea.credit.outstanding.wizard'].action_open_wizard()</field>
    </record>

    <record id="view_avea_credit_activity_wizard_form" model="ir.ui.view">
        <field name="name">avea.credit.activity.wizard.form</field>
        <field name="model">avea.credit.activity.wizard</field>
        <field name="arch" type="xml">
            <form string="Credit Activity Report" class="o_avea_wizard">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="reason_id" options="{'no_create': True}"/>
                    <field name="user_id" string="Employee"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_avea_credit_activity_wizard" model="ir.actions.server">
        <field name="name">Credit Activity Report</field>
        <field name="model_id" ref="model_avea_credit_activity_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env['avea.credit.activity.wizard'].action_open_wizard()</field>
    </record>

</odoo>
