<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pos_config_view_form_avea_credit" model="ir.ui.view">
        <field name="name">pos.config.form.avea.credit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="before">
                <setting string="Customer Credit" help="Allow cashiers to pay with Store Credit in this point of sale. Accounting and payment methods are configured automatically.">
                    <field name="avea_credit_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_form_avea_credit" model="ir.ui.view">
        <field name="name">pos.payment.method.form.avea.credit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="after">
                <field name="is_avea_store_credit" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
