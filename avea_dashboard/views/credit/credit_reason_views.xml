<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_credit_reason_list" model="ir.ui.view">
        <field name="name">avea.credit.reason.list</field>
        <field name="model">avea.credit.reason</field>
        <field name="arch" type="xml">
            <list string="Credit Reasons">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="manual_issue"/>
                <field name="system_generated"/>
                <field name="protected"/>
                <field name="is_outflow"/>
                <field name="active" widget="boolean_toggle" readonly="protected"/>
            </list>
        </field>
    </record>

    <record id="view_avea_credit_reason_form" model="ir.ui.view">
        <field name="name">avea.credit.reason.form</field>
        <field name="model">avea.credit.reason</field>
        <field name="arch" type="xml">
            <form string="Credit Reason">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Goodwill"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle" readonly="protected"/>
                        </group>
                        <group>
                            <field name="manual_issue"/>
                            <field name="system_generated"/>
                            <field name="protected"/>
                            <field name="is_outflow"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avea_credit_reason_search" model="ir.ui.view">
        <field name="name">avea.credit.reason.search</field>
        <field name="model">avea.credit.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Manual Issue" name="manual_issue" domain="[('manual_issue', '=', True)]"/>
                <filter string="System Generated" name="system_generated" domain="[('system_generated', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_avea_credit_reason" model="ir.actions.act_window">
        <field name="name">Credit Reasons</field>
        <field name="res_model">avea.credit.reason</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_avea_credit_reason_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a credit reason
            </p>
            <p>
                Credit reasons define why store credit is issued or adjusted.
            </p>
        </field>
    </record>

</odoo>
