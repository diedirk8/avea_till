<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_credit_ledger_entry_list" model="ir.ui.view">
        <field name="name">avea.credit.ledger.entry.list</field>
        <field name="model">avea.credit.ledger.entry</field>
        <field name="arch" type="xml">
            <list
                string="Store Credit Statement"
                create="false"
                edit="false"
                delete="false"
                default_order="transaction_date desc, id desc"
                class="o_avea_credit_ledger_list"
            >
                <field name="transaction_date" string="Date"/>
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="reason_id" string="Reason"/>
                <field name="reason_is_outflow" column_invisible="True"/>
                <field name="amount" widget="credit_ledger_amount"/>
                <field name="notes" string="Notes" optional="hide"/>
                <field name="user_id" string="Recorded By" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                    decoration-success="state == 'posted'"
                    decoration-muted="state == 'cancelled'"
                    optional="show"
                />
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_avea_credit_ledger_entry_form" model="ir.ui.view">
        <field name="name">avea.credit.ledger.entry.form</field>
        <field name="model">avea.credit.ledger.entry</field>
        <field name="arch" type="xml">
            <form string="Store Credit Entry" create="false" edit="false" delete="false" class="o_avea_wizard">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="posted,cancelled"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Statement Line">
                            <field name="partner_id" readonly="1"/>
                            <field name="transaction_date" readonly="1"/>
                            <field name="reason_id" readonly="1"/>
                            <field name="amount" widget="monetary" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group string="Recorded By">
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="pos_order_id" readonly="1" invisible="not pos_order_id"/>
                            <field name="account_move_id" readonly="1" invisible="not account_move_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" readonly="1" nolabel="1" placeholder="No notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avea_credit_ledger_entry_search" model="ir.ui.view">
        <field name="name">avea.credit.ledger.entry.search</field>
        <field name="model">avea.credit.ledger.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Customer"/>
                <field name="transaction_date" string="Date"/>
                <field name="reason_id" string="Reason"/>
                <field name="user_id" string="Recorded By"/>
                <field name="notes"/>
                <filter string="Confirmed" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Void" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Date" name="transaction_date" date="transaction_date"/>
                <filter string="Credit Issued" name="credit_issued" domain="[('reason_id.is_outflow', '=', False)]"/>
                <filter string="Credit Redeemed" name="credit_redeemed" domain="[('reason_id.is_outflow', '=', True)]"/>
                <filter string="Refunds" name="refund" domain="[('reason_id.name', '=', 'Refund')]"/>
                <filter string="POS Purchases" name="purchase" domain="[('reason_id.name', '=', 'POS Purchase')]"/>
                <filter string="Adjustments" name="adjustment" domain="[('reason_id.name', '=', 'Adjustment')]"/>
                <filter string="Goodwill" name="goodwill" domain="[('reason_id.name', '=', 'Goodwill')]"/>
                <filter string="Birthday" name="birthday" domain="[('reason_id.name', '=', 'Birthday')]"/>
                <filter string="Promotions" name="promotion" domain="[('reason_id.name', '=', 'Promotion')]"/>
                <filter string="Donations" name="donation" domain="[('reason_id.name', '=', 'Donation')]"/>
                <filter string="Animal Trade" name="animal_trade" domain="[('reason_id.name', '=', 'Animal Trade')]"/>
                <filter string="Other" name="other" domain="[('reason_id.name', '=', 'Other')]"/>
                <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Reason" name="group_reason" context="{'group_by': 'reason_id'}"/>
                <filter string="Recorded By" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Month" name="group_month" context="{'group_by': 'transaction_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_avea_credit_ledger" model="ir.actions.act_window">
        <field name="name">Customer Ledger</field>
        <field name="res_model">avea.credit.ledger.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_avea_credit_ledger_entry_search"/>
        <field name="context">{'search_default_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No store credit activity yet
            </p>
            <p>
                The complete history of store credit issued, redeemed and adjusted across all customers.
            </p>
        </field>
    </record>

</odoo>
