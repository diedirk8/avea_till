<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_sales_platform_list" model="ir.ui.view">
        <field name="name">avea.sales.platform.list</field>
        <field name="model">avea.sales.platform</field>
        <field name="arch" type="xml">
            <list string="Sales Platforms" class="o_avea_workspace o_avea_workspace--sales-platform o_avea_sales_platform_list" create="1" delete="1">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="display_pricelist" string="Pricelist"/>
                <field name="pricelist_is_active" string="Pricelist active" widget="boolean"/>
                <field name="commission_percent" string="Commission %"/>
                <field name="price_rounding_rule" optional="show"/>
                <field name="pricelist_item_count" string="Price lines" optional="show"/>
                <field name="last_price_update" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_avea_sales_platform_search" model="ir.ui.view">
        <field name="name">avea.sales.platform.search</field>
        <field name="model">avea.sales.platform</field>
        <field name="arch" type="xml">
            <search string="Sales Platforms">
                <field name="name"/>
                <field name="display_pricelist"/>
                <field name="partner_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_avea_sales_platform_form" model="ir.ui.view">
        <field name="name">avea.sales.platform.form</field>
        <field name="model">avea.sales.platform</field>
        <field name="arch" type="xml">
            <form string="Sales Platform" class="o_avea_workspace o_avea_workspace--sales-platform">
                <sheet class="o_avea_workspace_sheet">
                    <field name="currency_id" invisible="1"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="pricelist_id" invisible="1"/>
                    <field name="integration_ready" invisible="1"/>

                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">Sales Platforms</span>
                            <h1 class="o_avea_workspace_title">Sales Platform</h1>
                            <p class="o_avea_workspace_section_subtitle">
                                Commission-based marketplace pricing on a dedicated pricelist. Retail shelf prices are never changed.
                            </p>
                        </div>
                        <div class="o_avea_sales_platform_hero_actions">
                            <button string="Cancel" special="cancel" class="btn btn-secondary" data-hotkey="x"/>
                            <button
                                name="action_update_platform_prices"
                                type="object"
                                string="Update Platform Prices"
                                class="btn btn-outline-primary"
                                confirm="Recalculate platform prices from current retail prices for all saleable products?"
                                invisible="not integration_ready"
                            />
                            <button string="Save" special="save" class="btn btn-primary" data-hotkey="s"/>
                        </div>
                    </div>

                    <div class="o_avea_sales_platform_workspace">
                        <div class="o_avea_sales_platform_panel">
                            <h2 class="o_avea_workspace_section_title">Platform setup</h2>
                            <div class="o_avea_sales_platform_fields">
                                <div class="o_avea_workspace_info_item o_avea_sales_platform_field--wide">
                                    <span class="o_avea_workspace_info_label">Platform name</span>
                                    <field name="name" nolabel="1" placeholder="e.g. Mr D"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Active</span>
                                    <field name="active" nolabel="1" widget="boolean_toggle"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Commission %</span>
                                    <field name="commission_percent" nolabel="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">VAT on commission</span>
                                    <field name="commission_vat" nolabel="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item o_avea_sales_platform_field--wide">
                                    <span class="o_avea_workspace_info_label">Price rounding</span>
                                    <field name="price_rounding_rule" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="o_avea_sales_platform_panel o_avea_sales_platform_panel--integration">
                            <h2 class="o_avea_workspace_section_title">Linked customer &amp; pricelist</h2>
                            <p class="o_avea_workspace_section_subtitle">
                                Created automatically when you save. The platform pricelist holds your marketplace list prices.
                            </p>
                            <div class="o_avea_sales_platform_integration_grid">
                                <div class="o_avea_sales_platform_integration_card">
                                    <span class="o_avea_workspace_info_label">Platform customer</span>
                                    <field name="display_partner" nolabel="1" readonly="1" class="o_avea_sales_platform_integration_value"/>
                                    <button name="action_open_partner" type="object" class="btn btn-link btn-sm" string="Open customer" invisible="not partner_id"/>
                                </div>
                                <div class="o_avea_sales_platform_integration_card">
                                    <span class="o_avea_workspace_info_label">Platform pricelist</span>
                                    <field name="display_pricelist" nolabel="1" readonly="1" class="o_avea_sales_platform_integration_value"/>
                                    <div class="o_avea_sales_platform_integration_meta">
                                        <span class="o_avea_workspace_info_label">Pricelist status</span>
                                        <field name="pricelist_is_active" nolabel="1" readonly="1" widget="boolean_toggle"/>
                                    </div>
                                    <div class="o_avea_sales_platform_integration_actions">
                                        <button name="action_open_pricelist" type="object" class="btn btn-link btn-sm" string="Open pricelist" invisible="not pricelist_id"/>
                                        <button name="action_ensure_integration_links" type="object" class="btn btn-link btn-sm" string="Create / repair links" invisible="integration_ready"/>
                                    </div>
                                </div>
                            </div>
                            <field name="notes" placeholder="Internal notes..." class="mt-3"/>
                        </div>

                        <div class="o_avea_sales_platform_panel">
                            <h2 class="o_avea_workspace_section_title">Price lookup</h2>
                            <p class="o_avea_workspace_section_subtitle">
                                Spot-check one product before running a full pricelist update.
                            </p>
                            <div class="o_avea_workspace_info_item">
                                <span class="o_avea_workspace_info_label">Product</span>
                                <field name="lookup_product_id" nolabel="1" options="{'no_create': True}"/>
                            </div>
                            <div class="o_avea_sales_platform_lookup_grid">
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Retail (shelf)</span>
                                    <field name="lookup_retail_price_inc" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Platform list price</span>
                                    <field name="lookup_platform_price_inc" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Commission uplift</span>
                                    <field name="lookup_commission_amount_inc" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="o_avea_sales_platform_panel o_avea_sales_platform_panel--meta">
                            <h2 class="o_avea_workspace_section_title">Pricelist sync</h2>
                            <div class="o_avea_sales_platform_fields">
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Fixed price lines</span>
                                    <field name="pricelist_item_count" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_avea_workspace_info_item">
                                    <span class="o_avea_workspace_info_label">Last update</span>
                                    <field name="last_price_update" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                            <field name="settings_json" invisible="1"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_sales_platform" model="ir.actions.act_window">
        <field name="name">Sales Platforms</field>
        <field name="res_model">avea.sales.platform</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_avea_sales_platform_search"/>
        <field name="context">{'default_active': True}</field>
    </record>

</odoo>
