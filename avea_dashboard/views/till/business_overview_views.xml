<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_business_overview_product_line_list" model="ir.ui.view">
        <field name="name">avea.business.overview.product.line.list</field>
        <field name="model">avea.business.overview.product.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" class="o_avea_products_sold_list">
                <field name="product_name" string="Product"/>
                <field name="quantity_sold" string="Qty"/>
                <field name="sales_value" string="Sales Value" widget="monetary"/>
                <field name="product_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="rank" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_avea_business_overview_form" model="ir.ui.view">
        <field name="name">avea.business.overview.form</field>
        <field name="model">avea.business.overview</field>
        <field name="arch" type="xml">
            <form string="Business Overview" create="false" duplicate="false" delete="false" class="o_avea_workspace o_avea_workspace--overview">
                <sheet class="o_avea_workspace_sheet">
                    <field name="currency_id" invisible="1"/>
                    <field name="period" invisible="1"/>
                    <field name="sales_change_tone" invisible="1"/>
                    <field name="show_products" invisible="1"/>
                    <field name="show_open_sessions" invisible="1"/>
                    <field name="show_through_today" invisible="1"/>
                    <field name="show_busy_times" invisible="1"/>
                    <field name="show_busiest_day" invisible="1"/>
                    <field name="show_busiest_time" invisible="1"/>
                    <field name="show_slowest_day" invisible="1"/>
                    <field name="show_sales_trend" invisible="1"/>
                    <field name="show_sales_sparkline" invisible="1"/>
                    <field name="show_trading_pattern" invisible="1"/>

                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">How is my business doing?</span>
                            <h1 class="o_avea_workspace_title">Business Overview</h1>
                            <div class="o_avea_period_range">
                                <field name="period_range_display" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_comparison_range">
                                <field name="comparison_range_display" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_avea_through_today" invisible="not show_through_today">
                                <field name="through_today_display" nolabel="1" readonly="1"/>
                            </div>
                            <p class="o_avea_tax_note">Including tax</p>
                            <div class="o_avea_workspace_hero_meta" invisible="not show_open_sessions">
                                <field name="open_session_count" nolabel="1" readonly="1"/>
                                <span> tills open</span>
                            </div>
                        </div>
                        <div class="o_avea_period_selector">
                            <button
                                name="action_period_today"
                                type="object"
                                string="Today"
                                class="btn-primary o_avea_period_btn"
                                invisible="period != 'today'"
                            />
                            <button
                                name="action_period_today"
                                type="object"
                                string="Today"
                                class="btn-secondary o_avea_period_btn"
                                invisible="period == 'today'"
                            />
                            <button
                                name="action_period_week"
                                type="object"
                                string="This Week"
                                class="btn-primary o_avea_period_btn"
                                invisible="period != 'week'"
                            />
                            <button
                                name="action_period_week"
                                type="object"
                                string="This Week"
                                class="btn-secondary o_avea_period_btn"
                                invisible="period == 'week'"
                            />
                            <button
                                name="action_period_month"
                                type="object"
                                string="This Month"
                                class="btn-primary o_avea_period_btn"
                                invisible="period != 'month'"
                            />
                            <button
                                name="action_period_month"
                                type="object"
                                string="This Month"
                                class="btn-secondary o_avea_period_btn"
                                invisible="period == 'month'"
                            />
                            <button
                                name="action_period_custom"
                                type="object"
                                string="Custom Period"
                                class="btn-primary o_avea_period_btn"
                                invisible="period != 'custom'"
                            />
                            <button
                                name="action_period_custom"
                                type="object"
                                string="Custom Period"
                                class="btn-secondary o_avea_period_btn"
                                invisible="period == 'custom'"
                            />
                        </div>
                        <div class="o_avea_custom_period" invisible="period != 'custom'">
                            <div class="o_avea_custom_period_field">
                                <span class="o_avea_custom_period_label">From</span>
                                <field name="date_from" nolabel="1" readonly="0"/>
                            </div>
                            <div class="o_avea_custom_period_field">
                                <span class="o_avea_custom_period_label">To</span>
                                <field name="date_to" nolabel="1" readonly="0"/>
                            </div>
                            <button
                                name="action_apply_custom_period"
                                type="object"
                                string="Apply"
                                class="btn-primary o_avea_custom_period_apply"
                            />
                        </div>
                    </div>

                    <div class="o_avea_workspace_block">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Sales</h2>
                            <span class="o_avea_workspace_section_meta">
                                <field name="period_range_display" nolabel="1" readonly="1"/>
                            </span>
                        </div>
                        <div class="o_avea_pulse">
                            <div class="o_avea_pulse_main">
                                <span class="o_avea_pulse_label">Sales</span>
                                <div class="o_avea_pulse_figure">
                                    <field name="total_sales" nolabel="1" widget="monetary" readonly="1" class="o_avea_pulse_value"/>
                                    <div class="o_avea_pulse_spark" invisible="not show_sales_sparkline">
                                        <field name="sales_sparkline_html" nolabel="1" readonly="1" widget="html"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_avea_pulse_change o_avea_pulse_change--up" invisible="sales_change_tone != 'up'">
                                <field name="sales_change_display" nolabel="1" readonly="1" class="o_avea_pulse_change_pct"/>
                                <span class="o_avea_pulse_change_label">vs previous period</span>
                                <field name="sales_vs_previous_display" nolabel="1" readonly="1" class="o_avea_pulse_change_vs"/>
                            </div>
                            <div class="o_avea_pulse_change o_avea_pulse_change--down" invisible="sales_change_tone != 'down'">
                                <field name="sales_change_display" nolabel="1" readonly="1" class="o_avea_pulse_change_pct"/>
                                <span class="o_avea_pulse_change_label">vs previous period</span>
                                <field name="sales_vs_previous_display" nolabel="1" readonly="1" class="o_avea_pulse_change_vs"/>
                            </div>
                            <div class="o_avea_pulse_change o_avea_pulse_change--flat" invisible="sales_change_tone != 'flat'">
                                <field name="sales_change_display" nolabel="1" readonly="1" class="o_avea_pulse_change_pct"/>
                                <span class="o_avea_pulse_change_label">vs previous period</span>
                                <field name="sales_vs_previous_display" nolabel="1" readonly="1" class="o_avea_pulse_change_vs"/>
                            </div>
                        </div>
                        <div class="o_avea_pulse_metrics">
                            <div class="o_avea_pulse_metric">
                                <span class="o_avea_pulse_metric_label">Transactions</span>
                                <field name="order_count" nolabel="1" readonly="1" class="o_avea_pulse_metric_value"/>
                            </div>
                            <div class="o_avea_pulse_metric">
                                <span class="o_avea_pulse_metric_label">Average Sale</span>
                                <field name="average_order_value" nolabel="1" widget="monetary" readonly="1" class="o_avea_pulse_metric_value"/>
                            </div>
                            <div class="o_avea_pulse_metric">
                                <span class="o_avea_pulse_metric_label">Items Sold</span>
                                <field name="items_sold_display" nolabel="1" readonly="1" class="o_avea_pulse_metric_value"/>
                            </div>
                        </div>
                        <div class="o_avea_insights" invisible="not show_busy_times and not show_slowest_day">
                            <div class="o_avea_insight" invisible="not show_busiest_day">
                                <span class="o_avea_insight_label">Busiest Day</span>
                                <field name="busiest_day_name" nolabel="1" readonly="1" class="o_avea_insight_title"/>
                                <span class="o_avea_insight_meta">
                                    <field name="busiest_day_sales" nolabel="1" widget="monetary" readonly="1"/>
                                    <span> · </span>
                                    <field name="busiest_day_count" nolabel="1" readonly="1"/>
                                    <span> transactions</span>
                                </span>
                            </div>
                            <div class="o_avea_insight" invisible="not show_slowest_day">
                                <span class="o_avea_insight_label">Slowest Day</span>
                                <field name="slowest_day_name" nolabel="1" readonly="1" class="o_avea_insight_title"/>
                                <span class="o_avea_insight_meta">
                                    <field name="slowest_day_sales" nolabel="1" widget="monetary" readonly="1"/>
                                    <span> · </span>
                                    <field name="slowest_day_count" nolabel="1" readonly="1"/>
                                    <span> transactions</span>
                                </span>
                            </div>
                            <div class="o_avea_insight" invisible="not show_busiest_time">
                                <span class="o_avea_insight_label">Busiest Time</span>
                                <field name="busiest_time_display" nolabel="1" readonly="1" class="o_avea_insight_title"/>
                                <span class="o_avea_insight_meta">
                                    <field name="busiest_time_sales" nolabel="1" widget="monetary" readonly="1"/>
                                    <span> · </span>
                                    <field name="busiest_time_count" nolabel="1" readonly="1"/>
                                    <span> transactions</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Items and refunds</h2>
                        </div>
                        <div class="o_avea_workspace_kpi_grid">
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info o_avea_workspace_kpi_card--primary">
                                <span class="o_avea_workspace_kpi_label">Items Sold</span>
                                <field name="items_sold_display" nolabel="1" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Average Items per Sale</span>
                                <field name="average_items_display" nolabel="1" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--compact">
                                <span class="o_avea_workspace_kpi_label">Refunds</span>
                                <field name="activity_refund_count" nolabel="1" readonly="1" class="o_avea_workspace_kpi_value"/>
                                <span class="o_avea_workspace_kpi_subvalue">
                                    <field name="refund_total" nolabel="1" widget="monetary" readonly="1"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block o_avea_overview_visuals">
                        <div class="o_avea_overview_visual_panel o_avea_overview_visual_panel--trend">
                            <div class="o_avea_workspace_block_heading">
                                <div class="o_avea_overview_visual_heading">
                                    <h2 class="o_avea_workspace_section_title">Sales trend</h2>
                                    <p class="o_avea_workspace_section_subtitle">How much you are selling</p>
                                </div>
                                <span class="o_avea_workspace_section_meta">
                                    <field name="period_range_display" nolabel="1" readonly="1"/>
                                </span>
                            </div>
                            <div class="o_avea_visual_card" invisible="not show_sales_trend">
                                <field name="sales_trend_html" nolabel="1" readonly="1" widget="html"/>
                            </div>
                            <div class="o_avea_session_products_empty" invisible="show_sales_trend">
                                <p class="o_avea_session_products_empty_text">No sales in this period.</p>
                            </div>
                        </div>
                        <div class="o_avea_overview_visual_panel">
                            <div class="o_avea_workspace_block_heading">
                                <div class="o_avea_overview_visual_heading">
                                    <h2 class="o_avea_workspace_section_title">Trading Pattern</h2>
                                    <p class="o_avea_workspace_section_subtitle">When you trade (by day and time)</p>
                                </div>
                            </div>
                            <div class="o_avea_visual_card o_avea_visual_card--pattern" invisible="not show_trading_pattern">
                                <field name="trading_pattern_html" nolabel="1" readonly="1" widget="html"/>
                            </div>
                            <div class="o_avea_session_products_empty" invisible="show_trading_pattern">
                                <p class="o_avea_session_products_empty_text">No paid sales to show a trading pattern yet.</p>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Payments and cash</h2>
                            <button
                                name="action_open_cash"
                                type="object"
                                string="Open Cash"
                                class="btn-secondary o_avea_workspace_section_action"
                            />
                        </div>
                        <div class="o_avea_workspace_kpi_grid">
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--positive o_avea_workspace_kpi_card--primary">
                                <span class="o_avea_workspace_kpi_label">Cash</span>
                                <field name="cash_sales" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Card</span>
                                <field name="card_sales" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                            <div class="o_avea_workspace_kpi_card o_avea_workspace_kpi_card--info">
                                <span class="o_avea_workspace_kpi_label">Other</span>
                                <field name="other_payments" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_kpi_value"/>
                            </div>
                        </div>
                        <div class="o_avea_workspace_kpi_grid o_avea_workspace_kpi_grid--secondary o_avea_workspace_cash_grid">
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--positive">
                                <span class="o_avea_workspace_activity_label">Cash In</span>
                                <div class="o_avea_workspace_activity_detail">
                                    <field name="cash_in_total" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_activity_value"/>
                                    <span class="o_avea_workspace_activity_subvalue">
                                        <field name="cash_in_count" nolabel="1" readonly="1"/> times
                                    </span>
                                </div>
                            </div>
                            <div class="o_avea_workspace_activity_card o_avea_workspace_activity_card--negative">
                                <span class="o_avea_workspace_activity_label">Cash Out</span>
                                <div class="o_avea_workspace_activity_detail">
                                    <field name="cash_out_total" nolabel="1" widget="monetary" readonly="1" class="o_avea_workspace_activity_value"/>
                                    <span class="o_avea_workspace_activity_subvalue">
                                        <field name="cash_out_count" nolabel="1" readonly="1"/> times
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Top products</h2>
                            <button
                                name="action_open_sessions"
                                type="object"
                                string="View Sessions"
                                class="btn-secondary o_avea_workspace_section_action"
                            />
                        </div>
                        <div class="o_avea_session_products_empty" invisible="show_products">
                            <p class="o_avea_session_products_empty_text">No products sold in this period.</p>
                        </div>
                        <div class="o_avea_workspace_ledger_card o_avea_products_sold_card" invisible="not show_products">
                            <field name="product_line_ids" nolabel="1" readonly="1">
                                <list create="false" edit="false" delete="false" class="o_avea_products_sold_list">
                                    <field name="product_name" string="Product"/>
                                    <field name="quantity_sold" string="Qty"/>
                                    <field name="sales_value" string="Sales Value" widget="monetary"/>
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="rank" column_invisible="True"/>
                                </list>
                            </field>
                        </div>
                    </div>

                    <div class="o_avea_workspace_block o_avea_workspace_block--last o_avea_tax_summary">
                        <div class="o_avea_workspace_block_heading">
                            <h2 class="o_avea_workspace_section_title">Tax summary</h2>
                        </div>
                        <div class="o_avea_tax_summary_card">
                            <div class="o_avea_tax_summary_row">
                                <span class="o_avea_tax_summary_label">Sales before tax</span>
                                <field name="sales_before_tax" nolabel="1" widget="monetary" readonly="1" class="o_avea_tax_summary_value"/>
                            </div>
                            <div class="o_avea_tax_summary_row">
                                <span class="o_avea_tax_summary_label">Tax</span>
                                <field name="sales_tax" nolabel="1" widget="monetary" readonly="1" class="o_avea_tax_summary_value"/>
                            </div>
                            <div class="o_avea_tax_summary_row o_avea_tax_summary_row--total">
                                <span class="o_avea_tax_summary_label">Sales after tax</span>
                                <field name="sales_after_tax" nolabel="1" widget="monetary" readonly="1" class="o_avea_tax_summary_value"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_business_overview" model="ir.actions.server">
        <field name="name">Business Overview</field>
        <field name="model_id" ref="model_avea_business_overview"/>
        <field name="state">code</field>
        <field name="code">action = env['avea.business.overview'].action_open_business_overview()</field>
    </record>

</odoo>
