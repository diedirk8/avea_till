<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_printed_receipt_settings_form" model="ir.ui.view">
        <field name="name">avea.printed.receipt.settings.form</field>
        <field name="model">avea.printed.receipt.settings</field>
        <field name="arch" type="xml">
            <form string="Printed Receipt" create="false" duplicate="false" delete="false" class="o_avea_workspace o_avea_workspace--settings">
                <sheet class="o_avea_workspace_sheet">
                    <field name="company_id" invisible="1"/>

                    <div class="o_avea_workspace_hero">
                        <div class="o_avea_workspace_hero_intro">
                            <span class="o_avea_workspace_eyebrow">Business preferences</span>
                            <h1 class="o_avea_workspace_title">Printed Receipt</h1>
                            <p class="o_avea_workspace_lead">
                                Customize the physical receipt printed at the till. When customization is off, the standard Odoo POS receipt is used unchanged.
                            </p>
                        </div>
                        <div class="o_avea_settings_hero_actions">
                            <button
                                name="action_save_settings"
                                type="object"
                                string="Save settings"
                                class="btn btn-primary"
                                icon="fa-save"
                                data-hotkey="s"
                            />
                        </div>
                    </div>

                    <div class="o_avea_settings_sections">
                        <section class="o_avea_workspace_info_card o_avea_settings_section o_avea_settings_receipt_section">
                            <div class="o_avea_settings_receipt_layout">
                                <div class="o_avea_settings_receipt_controls">
                                    <h2 class="o_avea_settings_section_title">Printed POS Receipt</h2>
                                    <p class="o_avea_settings_section_help">
                                        Choose what appears on the receipt your cashier prints after each sale.
                                    </p>

                                    <div class="o_avea_settings_group">
                                        <h3 class="o_avea_settings_group_title">Enable customization</h3>
                                        <div class="o_avea_settings_row">
                                            <div class="o_avea_settings_row_copy">
                                                <div class="o_avea_settings_row_label">Customize printed POS receipt</div>
                                                <div class="o_avea_settings_row_hint">
                                                    When off, Avea leaves the standard Odoo POS receipt exactly as it is today.
                                                </div>
                                            </div>
                                            <field
                                                name="avea_customize_printed_receipt"
                                                widget="boolean_toggle"
                                                nolabel="1"
                                                class="o_avea_settings_toggle"
                                            />
                                        </div>
                                    </div>

                                    <div class="o_avea_settings_group" invisible="not avea_customize_printed_receipt">
                                        <h3 class="o_avea_settings_group_title">Branding</h3>
                                        <div class="o_avea_settings_field_grid">
                                            <div class="o_avea_settings_row o_avea_settings_row--inline o_avea_settings_field_grid_span">
                                                <div class="o_avea_settings_row_copy">
                                                    <div class="o_avea_settings_row_label">Show business logo</div>
                                                    <div class="o_avea_settings_row_hint">Uses your company logo when available.</div>
                                                </div>
                                                <field name="avea_print_receipt_show_logo" widget="boolean_toggle" nolabel="1" class="o_avea_settings_toggle"/>
                                            </div>
                                            <div class="o_avea_workspace_info_item" invisible="not avea_print_receipt_show_logo">
                                                <label class="o_avea_workspace_info_label" for="avea_print_receipt_logo_size">Logo size</label>
                                                <field name="avea_print_receipt_logo_size" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_workspace_info_item" invisible="not avea_print_receipt_show_logo">
                                                <label class="o_avea_workspace_info_label" for="avea_print_receipt_logo_max_height">Custom max height (px)</label>
                                                <field name="avea_print_receipt_logo_max_height" placeholder="0 = use preset" nolabel="1"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="o_avea_settings_group" invisible="not avea_customize_printed_receipt">
                                        <h3 class="o_avea_settings_group_title">What to include</h3>
                                        <p class="o_avea_settings_group_help">
                                            Turn sections on or off. Balance details only appear when a customer has a non-zero balance.
                                        </p>
                                        <div class="o_avea_settings_toggle_grid">
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Order number</span>
                                                <field name="avea_print_receipt_show_order_number" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Date and time</span>
                                                <field name="avea_print_receipt_show_datetime" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Customer</span>
                                                <field name="avea_print_receipt_show_customer" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Cashier</span>
                                                <field name="avea_print_receipt_show_cashier" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Products</span>
                                                <field name="avea_print_receipt_show_products" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">SKU / barcode</span>
                                                <field name="avea_print_receipt_show_sku" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Quantity</span>
                                                <field name="avea_print_receipt_show_quantity" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Unit price</span>
                                                <field name="avea_print_receipt_show_unit_price" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Discounts</span>
                                                <field name="avea_print_receipt_show_discounts" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Tax</span>
                                                <field name="avea_print_receipt_show_tax" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Subtotal</span>
                                                <field name="avea_print_receipt_show_subtotal" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Total</span>
                                                <field name="avea_print_receipt_show_total" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Payment method</span>
                                                <field name="avea_print_receipt_show_payment_method" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Amount paid</span>
                                                <field name="avea_print_receipt_show_amount_paid" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Change</span>
                                                <field name="avea_print_receipt_show_change" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Loyalty balance</span>
                                                <field name="avea_print_receipt_show_loyalty_balance" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Store Credit balance</span>
                                                <field name="avea_print_receipt_show_store_credit_balance" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_settings_toggle_item">
                                                <span class="o_avea_settings_toggle_label">Customer account balance</span>
                                                <field name="avea_print_receipt_show_customer_account_balance" widget="boolean_toggle" nolabel="1"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="o_avea_settings_group" invisible="not avea_customize_printed_receipt">
                                        <h3 class="o_avea_settings_group_title">Appearance</h3>
                                        <p class="o_avea_settings_group_help">
                                            Adjust layout density while keeping the familiar Avea printed receipt style.
                                        </p>
                                        <div class="o_avea_settings_field_grid">
                                            <div class="o_avea_workspace_info_item">
                                                <label class="o_avea_workspace_info_label" for="avea_print_receipt_layout">Layout</label>
                                                <field name="avea_print_receipt_layout" nolabel="1"/>
                                            </div>
                                            <div class="o_avea_workspace_info_item o_avea_settings_field_grid_span">
                                                <label class="o_avea_workspace_info_label" for="avea_print_receipt_footer_message">Custom footer message</label>
                                                <field name="avea_print_receipt_footer_message" widget="text" nolabel="1" placeholder="Thank you for shopping with us."/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <aside class="o_avea_settings_receipt_preview" invisible="not avea_customize_printed_receipt">
                                    <div class="o_avea_settings_preview_card">
                                        <div class="o_avea_settings_preview_header">
                                            <span class="o_avea_settings_preview_eyebrow">Live preview</span>
                                            <h3 class="o_avea_settings_preview_title">Printed receipt</h3>
                                            <p class="o_avea_settings_preview_help">Preview updates as you edit. Click Save settings to apply at the till.</p>
                                        </div>
                                        <div class="o_avea_settings_preview_frame o_avea_settings_preview_frame--thermal">
                                            <field
                                                name="printed_receipt_preview_html"
                                                widget="html"
                                                readonly="1"
                                                nolabel="1"
                                                class="o_avea_settings_preview_body o_avea_settings_preview_body--thermal"
                                            />
                                        </div>
                                    </div>
                                </aside>
                            </div>
                        </section>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avea_printed_receipt_settings" model="ir.actions.server">
        <field name="name">Printed Receipt</field>
        <field name="model_id" ref="model_avea_printed_receipt_settings"/>
        <field name="state">code</field>
        <field name="code">action = env['avea.printed.receipt.settings'].action_open_avea_printed_receipt_settings()</field>
    </record>

</odoo>
