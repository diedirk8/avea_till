<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_avea_sales_ledger_line_list" model="ir.ui.view">
        <field name="name">avea.sales.ledger.line.list</field>
        <field name="model">pos.order.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list
                string="Sales Ledger"
                create="false"
                edit="false"
                delete="false"
                import="false"
                default_order="avea_order_date desc, id desc"
                class="o_avea_sales_ledger_list"
                js_class="avea_sales_ledger_list"
            >
                <field name="avea_order_date" column_invisible="True"/>
                <field
                    name="avea_order_date_label"
                    string="Date / Time"
                    class="o_avea_ledger_date_cell"
                />
                <field
                    name="avea_order_reference"
                    string="Order #"
                    class="o_avea_sales_ledger_order_link"
                />
                <field
                    name="avea_product_display"
                    string="Product"
                    class="o_avea_ledger_product_cell"
                />
                <field name="avea_product_reference" column_invisible="True"/>
                <field name="product_id" column_invisible="True"/>
                <field name="qty" string="Qty" decoration-danger="qty &lt; 0"/>
                <field name="avea_order_partner_id" string="Customer" optional="show"/>
                <field name="order_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_avea_sales_ledger_line_search" model="ir.ui.view">
        <field name="name">avea.sales.ledger.line.search</field>
        <field name="model">pos.order.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Sales Ledger">
                <field
                    name="avea_product_display"
                    string="Product"
                    filter_domain="['|', '|', ('avea_product_display', 'ilike', self), ('avea_product_reference', 'ilike', self), ('product_id', 'ilike', self)]"
                />
                <field name="avea_order_partner_id" string="Customer"/>
                <field
                    name="avea_order_reference"
                    string="Order #"
                    filter_domain="['|', ('avea_order_reference', 'ilike', self), ('order_id.name', 'ilike', self)]"
                />
                <separator/>
                <filter
                    string="Today"
                    name="avea_ledger_today"
                    domain="[('avea_order_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('avea_order_date', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter
                    string="Last 7 Days"
                    name="avea_ledger_last_7"
                    domain="[('avea_order_date', '&gt;=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter
                    string="Last 30 Days"
                    name="avea_ledger_last_30"
                    domain="[('avea_order_date', '&gt;=', (context_today() - relativedelta(days=29)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter string="Refunds" name="refunds" domain="[('qty', '&lt;', 0)]"/>
                <filter string="Sales" name="sales" domain="[('qty', '&gt;', 0)]"/>
                <filter string="Date" name="filter_order_date" date="avea_order_date"/>
            </search>
        </field>
    </record>

    <record id="action_avea_sales_ledger_window" model="ir.actions.act_window">
        <field name="name">Sales Ledger</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_avea_sales_ledger_line_list"/>
        <field name="search_view_id" ref="view_avea_sales_ledger_line_search"/>
        <field name="domain">[]</field>
        <field name="context">{
            'avea_sales_ledger': True,
            'limit': 100,
            'create': False,
            'delete': False,
            'edit': False
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No product sales yet
            </p>
            <p>
                Individual product sale lines from completed POS orders appear here across all sessions.
            </p>
        </field>
    </record>

    <record id="action_avea_sales_ledger" model="ir.actions.server">
        <field name="name">Sales Ledger</field>
        <field name="model_id" ref="point_of_sale.model_pos_order_line"/>
        <field name="state">code</field>
        <field name="code">action = model.action_avea_open_sales_ledger()</field>
    </record>

    <record id="action_avea_sales_ledger_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_avea_sales_ledger_line_list"/>
        <field name="act_window_id" ref="action_avea_sales_ledger_window"/>
    </record>

</odoo>
