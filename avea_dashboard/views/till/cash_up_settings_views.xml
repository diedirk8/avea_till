<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_avea" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.avea.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Avea Dashboard"
                    string="Avea Dashboard"
                    name="avea_till"
                    groups="base.group_system,point_of_sale.group_pos_manager"
                >
                    <block title="Accounting / Cash Management" id="avea_cash_management_section">
                        <setting
                            id="avea_cash_safe_journal"
                            string="Cash Safe / Company Cash Journal"
                            company_dependent="1"
                            help="Select the existing cash journal that holds physical company cash outside the POS tills. Cash Up posts till cash to this Safe destination. Each POS that accepts cash must have its own till cash journal; do not select a till cash journal as this destination."
                        >
                            <field
                                name="avea_cash_safe_journal_id"
                                options="{'no_create': True, 'no_open': True}"
                                placeholder="Select a cash journal"
                                domain="[('type', '=', 'cash'), ('company_id', '=', company_id), ('name', 'not ilike', 'store credit')]"
                            />
                        </setting>
                        <setting
                            id="avea_transfer_journals"
                            string="Accounts available for Transfer Money"
                            company_dependent="1"
                            help="Choose which existing cash and bank accounts appear as From/To in Transfer Money. This does not create or change Odoo accounts. Unselected accounts stay in the books and can be hidden from Avea, including POS till cash such as Cash My Company."
                        >
                            <field
                                name="avea_transfer_journal_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('type', 'in', ('cash', 'bank')), ('company_id', '=', company_id), ('name', 'not ilike', 'store credit')]"
                            />
                        </setting>
                        <setting
                            id="avea_expense_journals"
                            string="Accounts available for Operational Expenses"
                            company_dependent="1"
                            help="Choose which existing cash and bank accounts appear as Paid From in Add Operational Expense. This does not create or change Odoo accounts. Unselected accounts stay in the books and can be hidden from Avea, including POS till cash such as Cash My Company."
                        >
                            <field
                                name="avea_expense_journal_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('type', 'in', ('cash', 'bank')), ('company_id', '=', company_id), ('name', 'not ilike', 'store credit')]"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
