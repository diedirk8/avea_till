<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <menuitem
        id="menu_avea_business_section"
        name="Business Overview"
        parent="menu_avea_root"
        groups="avea_till.group_avea_manager"
        sequence="5"
    />

    <menuitem
        id="menu_avea_business_overview"
        name="Overview"
        parent="menu_avea_business_section"
        action="action_avea_business_overview"
        groups="avea_till.group_avea_manager"
        sequence="5"
    />

    <menuitem
        id="menu_avea_business_performance"
        name="Performance"
        parent="menu_avea_business_section"
        action="action_avea_business_performance"
        groups="avea_till.group_avea_manager"
        sequence="10"
    />

    <menuitem
        id="menu_avea_business_transactions"
        name="Transactions"
        parent="menu_avea_business_section"
        action="action_avea_business_transactions"
        groups="avea_till.group_avea_manager"
        sequence="15"
    />

    <record id="action_avea_pos_sell" model="ir.actions.server">
        <field name="name">Sell</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">action = env["pos.config"].action_avea_open_pos()</field>
    </record>

    <menuitem
        id="menu_avea_pos_sell"
        name="Sell"
        parent="menu_avea_root"
        action="action_avea_pos_sell"
        groups="avea_till.group_avea_cashier"
        sequence="6"
    />

    <menuitem
        id="menu_avea_till"
        name="Sessions"
        parent="menu_avea_root"
        action="action_avea_session_dashboard"
        groups="avea_till.group_avea_cashier"
        sequence="10"
    />

    <record id="menu_avea_till" model="ir.ui.menu">
        <field name="action" ref="action_avea_session_dashboard"/>
    </record>

    <menuitem
        id="menu_avea_session_dashboard"
        name="Session Dashboard"
        parent="menu_avea_till"
        action="action_avea_session_dashboard"
        groups="avea_till.group_avea_cashier"
        sequence="5"
    />

    <menuitem
        id="menu_avea_sales_ledger"
        name="Sales Ledger"
        parent="menu_avea_till"
        action="action_avea_sales_ledger"
        groups="avea_till.group_avea_manager"
        sequence="10"
    />

    <record id="menu_avea_session_dashboard" model="ir.ui.menu">
        <field name="active" eval="True"/>
    </record>

    <menuitem
        id="menu_avea_settings"
        name="Settings"
        parent="menu_avea_root"
        groups="avea_till.group_avea_manager"
        sequence="90"
    />

    <menuitem
        id="menu_avea_settings_email"
        name="Email Receipt"
        parent="menu_avea_settings"
        action="action_avea_settings"
        groups="avea_till.group_avea_manager"
        sequence="10"
    />

    <menuitem
        id="menu_avea_settings_printed"
        name="Printed Receipt"
        parent="menu_avea_settings"
        action="action_avea_printed_receipt_settings"
        groups="avea_till.group_avea_manager"
        sequence="20"
    />

    <menuitem
        id="menu_avea_cash_up"
        name="Cash Ups"
        parent="menu_avea_root"
        action="action_avea_cash_up"
        groups="avea_till.group_avea_cash_up_manager"
        sequence="16"
    />

    <menuitem
        id="menu_avea_configuration"
        name="Configuration"
        parent="menu_avea_till"
        groups="avea_till.group_avea_manager"
        sequence="99"
    />

    <record id="menu_avea_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
