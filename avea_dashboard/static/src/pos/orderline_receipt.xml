<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//span[@class='text-wrap d-inline']" position="inside">
            <div t-if="vals.aveaSkuLabel" class="avea-pos-receipt-sku">
                SKU: <t t-esc="vals.aveaSkuLabel"/>
            </div>
        </xpath>
    </t>

</templates>
