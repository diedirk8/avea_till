<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-topheader')]" position="replace">
            <div class="pos-topheader avea-pos-topheader position-relative d-flex align-items-center p-0 m-0">
                <div class="avea-topheader-bar d-flex align-items-center w-100 min-w-0">
                    <div class="avea-topheader-brand-group d-flex align-items-center flex-shrink-0">
                        <div class="avea-pos-brand" aria-label="Avea POS">
                            <span class="avea-pos-mark" aria-hidden="true">
                                <i class="fa fa-th" aria-hidden="true"/>
                            </span>
                            <span class="avea-pos-wordmark">
                                <span class="avea-pos-wordmark-accent">Avea</span> POS
                            </span>
                        </div>
                        <div class="avea-topheader-session">
                            <OrderTabs orders="getOrderTabs()"/>
                        </div>
                    </div>

                    <div t-if="!ui.isSmall" class="avea-topheader-meta d-flex align-items-center flex-grow-1 min-w-0">
                        <div class="avea-header-selector" t-if="aveaCompanyName">
                            <span class="avea-header-selector-label">Business</span>
                            <span class="avea-header-selector-value">
                                <span class="avea-header-selector-text" t-esc="aveaCompanyName"/>
                                <i class="fa fa-chevron-down avea-header-selector-caret" aria-hidden="true"/>
                            </span>
                        </div>
                        <div class="avea-header-selector">
                            <span class="avea-header-selector-label">Till</span>
                            <span class="avea-header-selector-value">
                                <span class="avea-header-selector-text" t-esc="aveaTillName"/>
                                <i class="fa fa-chevron-down avea-header-selector-caret" aria-hidden="true"/>
                            </span>
                        </div>
                        <div class="avea-header-selector">
                            <span class="avea-header-selector-label">Cashier</span>
                            <span class="avea-header-selector-value">
                                <span class="avea-header-selector-text" t-esc="aveaCashierName"/>
                            </span>
                        </div>
                    </div>

                    <div class="avea-topheader-actions d-flex align-items-center flex-shrink-0">
                        <CashierName t-if="false"/>
                        <div t-if="aveaNetworkBusy" class="oe_status avea-header-status">
                            <span t-if="aveaUnsyncCount > 0" class="avea-header-status-count" t-esc="aveaUnsyncCount"/>
                            <i t-if="aveaNetworkOffline" class="fa fa-chain-broken" aria-hidden="true"/>
                            <i t-else="" class="fa fa-spin fa-circle-o-notch" aria-hidden="true"/>
                        </div>
                        <div t-else="" class="avea-header-status avea-header-status--online">
                            <span class="avea-header-online-dot" aria-hidden="true"/>
                            <span>Online</span>
                        </div>
                        <span t-if="!ui.isSmall" class="avea-header-datetime" t-esc="aveaDateTimeLabel"/>
                        <button
                            type="button"
                            class="avea-header-icon-btn avea-header-lock d-none d-md-inline-flex"
                            title="Lock"
                            t-on-click="() => this.pos.showLoginScreen()"
                        >
                            <i class="fa fa-lock" aria-hidden="true"/>
                        </button>
                        <Dropdown>
                            <button type="button" class="btn avea-menu-btn">
                                <i class="fa fa-bars" aria-hidden="true"/>
                                <span t-if="!ui.isSmall" class="avea-menu-label">Menu</span>
                            </button>
                            <t t-set-slot="content">
                                <div class="d-flex gap-2 p-2 border-bottom">
                                    <ProxyStatus t-if="pos.config.useProxy"/>
                                    <span
                                        t-on-click="openCustomerDisplay"
                                        role="button"
                                        t-attf-class="{{pos.config.useProxy ? 'd-flex align-items-center justify-content-center' : ''}} btn btn-secondary btn-lg w-100 text-center"
                                        title="Customer Display"
                                    >
                                        <i class="fa fa-fw fa-desktop"/>
                                    </span>
                                </div>
                                <div class="p-2 pos-burger-menu-items">
                                    <DropdownItem onSelected="() => this.onClickRegister()">
                                        Register
                                    </DropdownItem>
                                    <DropdownItem onSelected="() => this.pos.navigate('TicketScreen')">
                                        Orders
                                    </DropdownItem>
                                    <DropdownItem
                                        t-if="showPosSettingsMenu"
                                        onSelected="() => this.openPosSettings()"
                                    >
                                        POS Settings
                                    </DropdownItem>
                                    <DropdownItem t-if="!isDisplayStandalone and !isMinimalCashier" onSelected="() => window.open(this.appUrl)">
                                        Install App
                                    </DropdownItem>
                                    <DropdownItem t-if="showCashMoveButton and !isMinimalCashier" onSelected="() => this.pos.cashMove()">
                                        Cash In/Out
                                    </DropdownItem>
                                    <DropdownItem
                                        t-if="showIssueStoreCreditMenu"
                                        onSelected="() => this.issueStoreCredit()"
                                    >
                                        Issue Store Credit
                                    </DropdownItem>
                                    <DropdownItem
                                        t-if="showCashUpMenu"
                                        onSelected="() => this.openCashUp()"
                                    >
                                        Cash Up
                                    </DropdownItem>
                                    <DropdownItem t-if="!this.pos.data.network.offline" onSelected="() => this.reloadProducts()">
                                        Reload Data
                                    </DropdownItem>
                                    <DropdownItem t-if="showCreateProductButton" onSelected="() => this.pos.editProduct()">
                                        Create Product
                                    </DropdownItem>
                                    <DropdownItem t-if="isBarcodeScannerSupported() and pos.router.state.current == 'ProductScreen' and ui.isSmall and !pos.config.module_pos_restaurant" onSelected="() => this.onClickScan()">
                                        <span t-if="this.pos.scanning">Stop Barcode Scanner</span>
                                        <span t-else="">Barcode Scanner</span>
                                    </DropdownItem>
                                    <DropdownItem t-if="hardwareProxy and hardwareProxy.printer" onSelected="() => this.showSaleDetails()">
                                        Print Report
                                    </DropdownItem>
                                    <DropdownItem t-if="showBackend" onSelected="() => pos.closePos()">
                                        Backend
                                    </DropdownItem>
                                    <DropdownItem t-if="showCloseRegister" onSelected="() => this.pos.closeSession()">
                                        Close Register
                                    </DropdownItem>
                                </div>
                                <div class="border-top p-2">
                                    <span t-on-click="openLnaPopup" role="button" t-attf-class="{{aveaLnaButtonClass}}" title="Local Network Access">
                                        <i class="fa fa-wifi" aria-hidden="true"/> Local Network Access
                                    </span>
                                </div>
                            </t>
                        </Dropdown>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
