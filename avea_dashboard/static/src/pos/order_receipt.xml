<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-att-class">{
                'pos-receipt p-2': true,
                [aveaPrintLayoutClass]: aveaPrintCustomizeEnabled,
            }</attribute>
        </xpath>

        <xpath expr="//OrderDisplay" position="attributes">
            <attribute name="t-if">aveaShowProductsSection</attribute>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="attributes">
            <attribute name="t-if">taxTotals and taxTotals.has_tax_groups and (!aveaPrintCustomizeEnabled or (aveaPrintShow('avea_print_receipt_show_tax') or aveaPrintShow('avea_print_receipt_show_subtotal')))</attribute>
        </xpath>

        <xpath expr="//div[hasclass('receipt-total')]" position="attributes">
            <attribute name="t-if">!aveaPrintCustomizeEnabled or aveaPrintShow('avea_print_receipt_show_total')</attribute>
        </xpath>

        <xpath expr="//div[hasclass('paymentlines')]" position="attributes">
            <attribute name="t-if">!aveaPrintCustomizeEnabled or aveaPrintShow('avea_print_receipt_show_payment_method')</attribute>
        </xpath>

        <xpath expr="//div[hasclass('receipt-change')]" position="attributes">
            <attribute name="t-if">order.showChange and (!aveaPrintCustomizeEnabled or aveaPrintShow('avea_print_receipt_show_change'))</attribute>
        </xpath>

        <xpath expr="//div[hasclass('text-start')][span[hasclass('label-discount')]]" position="attributes">
            <attribute name="t-if">totalDiscount and (!aveaPrintCustomizeEnabled or aveaPrintShow('avea_print_receipt_show_discounts'))</attribute>
        </xpath>

        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <t t-if="aveaPrintCustomizeEnabled and aveaPrintShow('avea_print_receipt_show_amount_paid')">
                <div class="pos-receipt-amount receipt-amount-paid d-flex">
                    <span>Amount Paid</span>
                    <span t-out="formatCurrency(aveaTotalAmountPaid)" class="ms-auto font-monospace"/>
                </div>
            </t>

            <t t-if="showStoreCreditReceiptInfo">
                <div class="pos-receipt-store-credit pt-2 text-start">
                    <t t-if="storeCreditUsed > 0">
                        <div class="d-flex">
                            <span>Store Credit Used:</span>
                            <span t-esc="formatStoreCreditAmount(storeCreditUsed)" class="ms-auto font-monospace"/>
                        </div>
                    </t>
                    <div class="d-flex">
                        <span t-esc="storeCreditUsed > 0 ? 'Remaining Store Credit:' : 'Store Credit:'"/>
                        <span t-esc="formatStoreCreditAmount(storeCreditRemainingBalance)" class="ms-auto font-monospace"/>
                    </div>
                </div>
            </t>

            <t t-if="aveaShowLoyaltyBalance">
                <div class="pos-receipt-loyalty pt-2 text-start">
                    <div class="fw-bolder">Loyalty Balance</div>
                    <t t-foreach="aveaLoyaltyBalanceLines" t-as="loyaltyLine" t-key="loyaltyLine_index">
                        <div class="d-flex">
                            <span t-esc="loyaltyLine.label"/>
                            <span t-esc="loyaltyLine.value" class="ms-auto font-monospace"/>
                        </div>
                    </t>
                </div>
            </t>

            <t t-if="aveaShowCustomerAccountBalance">
                <div class="pos-receipt-account-balance pt-2 text-start d-flex">
                    <span>Account Balance</span>
                    <span t-out="formatCurrency(aveaCustomerAccountBalance)" class="ms-auto font-monospace"/>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt-center-align')]" position="before">
            <t t-if="aveaCustomFooterMessage">
                <div class="pos-receipt-center-align pt-3 text-center avea-pos-receipt-custom-footer">
                    <t t-esc="aveaCustomFooterMessage"/>
                </div>
            </t>
        </xpath>
    </t>

</templates>
